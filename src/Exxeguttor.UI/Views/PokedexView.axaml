<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exxeguttor.UI.ViewModels"
             xmlns:conv="using:Exxeguttor.UI.Converters"
             xmlns:objconv="using:Avalonia.Data.Converters"
             x:Class="Exxeguttor.UI.Views.PokedexView"
             x:DataType="vm:PokedexViewModel">

  <!-- Plantillas implícitas (por DataType, sin x:Key) para el contenido que gira dentro
       del TransitioningContentControl más abajo — Avalonia elige automáticamente cuál
       usar según el tipo real del objeto puesto en Content, sin necesitar un selector a
       mano. CurrentFace (en PokedexViewModel) devuelve ExpandedCard (frente) o this mismo
       (reverso, ya que EvolutionFlow/OriginGenus/etc. viven directo en el ViewModel).
       IMPORTANTE: van en UserControl.DataTemplates, NO en UserControl.Resources — ese
       último exige x:Key en cada entrada (Avalonia error AVLN3000 si se mezclan). -->
  <UserControl.DataTemplates>

    <!-- FRENTE: mismo lenguaje visual que la tarjeta chica de la grilla, agrandado. -->
    <DataTemplate DataType="vm:PokedexCardViewModel">
      <Grid Width="360" Height="440" Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
          <TextBlock Text="{Binding DexNumberDisplay}" FontSize="13" Opacity="0.5"
                     HorizontalAlignment="Center"/>
          <Image Source="{Binding Sprite}" Width="140" Height="140" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
          <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border CornerRadius="8" Padding="10,3"
                        Background="{Binding Converter={x:Static conv:TypeColorConverter.Instance}}">
                  <TextBlock Text="{Binding Converter={x:Static conv:TypeNameConverter.Instance}}" FontSize="12" Foreground="White"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- REVERSO: this mismo (PokedexViewModel) — EvolutionFlow ya viene armado (nodos +
         flechas mezclados) desde PokedexViewModel.BuildEvolutionFlow; cada ítem se
         resuelve por DataType igual que acá arriba, ver las dos plantillas de más abajo. -->
    <DataTemplate DataType="vm:PokedexViewModel">
      <StackPanel Width="380" Margin="20" Spacing="16">

        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="{Binding ExpandedCard.Sprite}" Width="60" Height="60"/>
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding ExpandedCard.DexNumberDisplay}" FontSize="11" Opacity="0.5"/>
            <TextBlock Text="{Binding ExpandedCard.Name}" FontSize="16" FontWeight="Bold"/>
            <ItemsControl ItemsSource="{Binding ExpandedCard.Types}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border CornerRadius="8" Padding="8,2"
                          Background="{Binding Converter={x:Static conv:TypeColorConverter.Instance}}">
                    <TextBlock Text="{Binding Converter={x:Static conv:TypeNameConverter.Instance}}" FontSize="10" Foreground="White"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <Border BorderThickness="0,1,0,0" Opacity="0.15"/>

        <!-- Cadena evolutiva: un solo WrapPanel con nodos y flechas mezclados
             (EvolutionFlow), fluye horizontal y solo baja de línea si no entra —
             aprovecha el ancho en vez de apilar todo en columna. -->
        <StackPanel Spacing="10" IsVisible="{Binding !HasNoEvolutionData}">
          <TextBlock Text="{Binding Loc[Pokedex_EvolutionChain]}" FontSize="11" Opacity="0.55"/>
          <ItemsControl ItemsSource="{Binding EvolutionFlow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding Loc[Pokedex_NoEvolutionData]}"
                   FontSize="11" Opacity="0.55" FontStyle="Italic"
                   IsVisible="{Binding HasNoEvolutionData}"/>

        <Border BorderThickness="0,1,0,0" Opacity="0.15"/>

        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Loc[Pokedex_OriginData]}" FontSize="11" Opacity="0.55"/>
          <StackPanel Spacing="4" IsVisible="{Binding HasOriginData}">
            <TextBlock Text="{Binding OriginGenus}" FontSize="11" Opacity="0.6" FontStyle="Italic"/>
            <TextBlock Text="{Binding OriginFlavorText}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock FontSize="11" Opacity="0.55">
              <Run Text="{Binding Loc[Pokedex_Habitat]}"/><Run Text="{Binding OriginHabitat}"/>
            </TextBlock>
          </StackPanel>
          <TextBlock Text="{Binding Loc[Pokedex_NoOriginData]}"
                     FontSize="11" Opacity="0.55" FontStyle="Italic"
                     IsVisible="{Binding !HasOriginData}"/>
        </StackPanel>

        <TextBlock Text="{Binding Loc[Pokedex_TapOutside]}"
                   FontSize="10" Opacity="0.4" HorizontalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <!-- Ítems del flujo de evolución — nodo (sprite+nombre+condición, resaltado si es
         "esta especie") o flecha "→" entre nodos. Elegidos automático por DataType,
         mismo mecanismo que las dos plantillas de arriba. -->
    <DataTemplate DataType="vm:PokedexEvolutionFlowNode">
      <Border Margin="0,0,10,10" Padding="6" CornerRadius="8"
              Background="{Binding IsSelf, Converter={x:Static conv:BoolToHighlightBrushConverter.Instance}}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="{Binding Sprite}" Width="32" Height="32"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="12"
                       FontWeight="{Binding IsSelf, Converter={x:Static conv:BoolToFontWeightConverter.Instance}}"/>
            <TextBlock Text="{Binding ConditionText}" FontSize="10" Opacity="0.55"
                       IsVisible="{Binding ConditionText, Converter={x:Static objconv:ObjectConverters.IsNotNull}}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:PokedexEvolutionFlowArrow">
      <TextBlock Text="→" FontSize="18" Opacity="0.4" VerticalAlignment="Center" Margin="0,0,10,10"/>
    </DataTemplate>
    <!-- Separador entre ramas alternativas (Exeggutor / Exeggutor de Alola): "/" en vez de flecha -->
    <DataTemplate DataType="vm:PokedexEvolutionFlowAlt">
      <TextBlock Text="/" FontSize="18" Opacity="0.4" VerticalAlignment="Center" Margin="0,0,10,10"/>
    </DataTemplate>

  </UserControl.DataTemplates>

  <!-- Estallido de chispas estilo "pack reveal" — Avalonia no tiene sistema de
       partículas, así que esto son 8 chispas (Path) + 1 flash (Ellipse) fijas en anillo
       alrededor del centro, cada una con su propia animación de keyframes (escala +
       opacidad) disparada desde PokedexView.axaml.cs cuando se toca una tarjeta. Las
       Setter Property="ScaleTransform.ScaleX/Y" SÍ animan con Animation de keyframes (a
       diferencia de Transitions simples sobre RenderTransform, que necesitan el formato
       CSS-like — ver Rotate3DTransition abajo). x:SetterTargetType es obligatorio acá:
       fuera de un Style (que da el tipo vía Selector), un Setter suelto en una Animation
       usada como recurso independiente necesita que se lo digamos explícito, si no
       Avalonia tira AVLN2200 "no se pudo determinar el tipo del Setter". -->
  <UserControl.Resources>
    <Animation x:Key="FlashAnimation" x:SetterTargetType="Ellipse" Duration="0:0:0.5" FillMode="Forward">
      <KeyFrame Cue="0%">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.2"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.2"/>
      </KeyFrame>
      <KeyFrame Cue="35%">
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="ScaleTransform.ScaleX" Value="1.5"/>
        <Setter Property="ScaleTransform.ScaleY" Value="1.5"/>
      </KeyFrame>
      <KeyFrame Cue="100%">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="ScaleTransform.ScaleX" Value="2.2"/>
        <Setter Property="ScaleTransform.ScaleY" Value="2.2"/>
      </KeyFrame>
    </Animation>
    <Animation x:Key="SparkBurstAnimation" x:SetterTargetType="Path" Duration="0:0:0.6" FillMode="Forward">
      <KeyFrame Cue="0%">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.2"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.2"/>
      </KeyFrame>
      <KeyFrame Cue="30%">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="ScaleTransform.ScaleX" Value="1.3"/>
        <Setter Property="ScaleTransform.ScaleY" Value="1.3"/>
      </KeyFrame>
      <KeyFrame Cue="100%">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="ScaleTransform.ScaleX" Value="0.85"/>
        <Setter Property="ScaleTransform.ScaleY" Value="0.85"/>
      </KeyFrame>
    </Animation>
  </UserControl.Resources>

  <Grid>

    <!-- ── Grilla + paginado ─────────────────────────────────────────── -->
    <Grid RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Height="40" Margin="12,0">
        <Button Grid.Column="0" Content="◀" Command="{Binding PreviousPageCommand}"
                IsEnabled="{Binding CanGoPrevious}" Padding="10,3" FontSize="11"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
          <TextBlock Text="{Binding PageLabel}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding OwnedCountLabel}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="2" Content="▶" Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoNext}" Padding="10,3" FontSize="11"/>
      </Grid>

      <Border Grid.Row="1" x:Name="GridArea" ClipToBounds="True">
        <ItemsControl x:Name="AlbumGrid" ItemsSource="{Binding VisibleCards}" Margin="12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PokedexCardViewModel">
              <Border Width="130" Height="150" Margin="6" CornerRadius="12"
                      Padding="3" Background="{Binding FrameBrush}">
                <Border CornerRadius="9" Background="#FFFFFF" Opacity="{Binding Owned, Converter={StaticResource BoolToOpacityConverter}}">
                  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="6">
                    <TextBlock Grid.Row="0" Text="{Binding DexNumberDisplay}"
                               FontSize="9" Opacity="0.5" HorizontalAlignment="Left"/>
                    <Image Grid.Row="1" Source="{Binding Sprite}" Width="56" Height="56"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="11"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Types}"
                                  HorizontalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border CornerRadius="8" Padding="6,1"
                                  Background="{Binding Converter={x:Static conv:TypeColorConverter.Instance}}">
                            <TextBlock Text="{Binding Converter={x:Static conv:TypeNameConverter.Instance}}" FontSize="8" Foreground="White"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <!-- ── Overlay de detalle — solo tarjetas poseídas llegan acá. ExpandedCard es null
         en cualquier otro caso; CloseDetailCommand (click afuera) dispara el cierre
         animado (gira de vuelta al frente + achica/desvanece, ver
         PokedexViewModel.CloseDetailAsync). ── -->
    <Grid IsVisible="{Binding IsDetailOpen}">
      <Button Background="#73141416" BorderThickness="0" Command="{Binding CloseDetailCommand}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

      <!-- Capa de destellos — detrás de la tarjeta, sin bloquear clicks (IsHitTestVisible
           False), centrada en el mismo punto que el panel. Ver animaciones definidas
           arriba en Resources; RunAsync se dispara desde PokedexView.axaml.cs. -->
      <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="1" Height="1"
              IsHitTestVisible="False" ClipToBounds="False">
        <Ellipse x:Name="FlashEllipse" Width="640" Height="640" Canvas.Left="-320" Canvas.Top="-320" Opacity="0">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FFFFFFFF" Offset="0"/>
              <GradientStop Color="#00FFFFFF" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Path x:Name="Spark0" Data="M0,-9 L3,-3 L9,0 L3,3 L0,9 L-3,3 L-9,0 L-3,-3 Z" Fill="#FFD54A" Canvas.Left="253" Canvas.Top="-7" Opacity="0"/>
        <Path x:Name="Spark1" Data="M0,-9 L3,-3 L9,0 L3,3 L0,9 L-3,3 L-9,0 L-3,-3 Z" Fill="#FFFFFF" Canvas.Left="177" Canvas.Top="177" Opacity="0"/>
        <Path x:Name="Spark2" Data="M0,-9 L3,-3 L9,0 L3,3 L0,9 L-3,3 L-9,0 L-3,-3 Z" Fill="#FFD54A" Canvas.Left="-7" Canvas.Top="253" Opacity="0"/>
        <Path x:Name="Spark3" Data="M0,-9 L3,-3 L9,0 L3,3 L0,9 L-3,3 L-9,0 L-3,-3 Z" Fill="#FFFFFF" Canvas.Left="-191" Canvas.Top="177" Opacity="0"/>
        <Path x:Name="Spark4" Data="M0,-9 L3,-3 L9,0 L3,3 L0,9 L-3,3 L-9,0 L-3,-3 Z" Fill="#FFD54A" Canvas.Left="-267" Canvas.Top="-7" Opacity="0"/>
        <Path x:Name="Spark5" Data="M0,-9 L3,-3 L9,0 L3,3 L0,9 L-3,3 L-9,0 L-3,-3 Z" Fill="#FFFFFF" Canvas.Left="-191" Canvas.Top="-191" Opacity="0"/>
        <Path x:Name="Spark6" Data="M0,-9 L3,-3 L9,0 L3,3 L0,9 L-3,3 L-9,0 L-3,-3 Z" Fill="#FFD54A" Canvas.Left="-7" Canvas.Top="-267" Opacity="0"/>
        <Path x:Name="Spark7" Data="M0,-9 L3,-3 L9,0 L3,3 L0,9 L-3,3 L-9,0 L-3,-3 Z" Fill="#FFFFFF" Canvas.Left="177" Canvas.Top="-191" Opacity="0"/>
      </Canvas>

      <Border MaxWidth="420" MaxHeight="700" MinWidth="360" MinHeight="490"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="14" Padding="4" Background="{Binding ExpandedCard.FrameBrush}"
              BoxShadow="0 20 40 0 #40000000"
              RenderTransform="{Binding PanelScale}"
              Opacity="{Binding PanelOpacity}"
              ClipToBounds="True">
        <Border.Transitions>
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3"/>
            <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
          </Transitions>
        </Border.Transitions>

        <Border CornerRadius="11" Background="White" ClipToBounds="True">
          <!-- Giro real frente↔reverso: TransitioningContentControl cambia de Content
               (CurrentFace) usando Rotate3DTransition — ver hallazgo de la sesión: los
               transforms estilo RotateTransform/ScaleTransform NO animan con Transitions
               comunes; para el giro se usa esta transición dedicada de contenido en vez
               de manejar el RenderTransform a mano. -->
          <TransitioningContentControl x:Name="FaceContent" Content="{Binding CurrentFace}">
            <TransitioningContentControl.PageTransition>
              <Rotate3DTransition Duration="0:0:0.4" Orientation="Vertical"/>
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>
        </Border>
      </Border>
    </Grid>

  </Grid>
</UserControl>
