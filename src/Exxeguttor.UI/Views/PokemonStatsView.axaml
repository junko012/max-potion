<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exxeguttor.UI.ViewModels"
             xmlns:services="using:Exxeguttor.UI.Services"
             xmlns:app="using:Exxeguttor.App.Services"
             x:Class="Exxeguttor.UI.Views.PokemonStatsView"
             x:DataType="vm:PokemonEditorViewModel"
             IsVisible="{Binding IsVisible}">

    <UserControl.Resources>
        <!-- Tab Ribbons (mockup ribbons-tab): glifos de la tarjeta-medalla, caja 24×24 -->
        <StreamGeometry x:Key="IconMedal">M7,14 A5,5 0 1 0 17,14 A5,5 0 1 0 7,14 M8.5,3 L12,9.5 M15.5,3 L12,9.5</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M5,12 L10,17 L19,7</StreamGeometry>
        <StreamGeometry x:Key="IconChevron">M6,9 L12,15 L18,9</StreamGeometry>
    </UserControl.Resources>

    <TabControl x:Name="StatsTabs" TabStripPlacement="Top"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch">
        <!-- Pestañas SIEMPRE en una sola fila (antes el WrapPanel por defecto las partía en dos niveles
             cuando aparecía Diagnóstico). Si no entran, se desplazan con flechas ◀ ▶ a los costados;
             las flechas solo se ven cuando hay desborde (cableado en PokemonStatsView.axaml.cs). -->
        <TabControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </TabControl.ItemsPanel>
        <TabControl.Template>
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
                            <RepeatButton Name="PART_TabLeft" Grid.Column="0" Classes="tab-arrow" IsVisible="False">
                                <Path Data="M9,3 L4,8 L9,13" Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </RepeatButton>
                            <ScrollViewer Name="PART_TabScroll" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </ScrollViewer>
                            <RepeatButton Name="PART_TabRight" Grid.Column="2" Classes="tab-arrow" IsVisible="False">
                                <Path Data="M7,3 L12,8 L7,13" Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </RepeatButton>
                        </Grid>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </TabControl.Template>
        <TabControl.Styles>
            <!-- Fluent fuerza MinHeight=32 en Button/TextBox: sin esto los spinners de las filas no bajan de ~32 px -->
            <!-- Botón "editar movimiento" (lápiz azul) -->
            <Style Selector="Button.move-edit">
                <Setter Property="Background" Value="#E6F1FB"/>
                <Setter Property="BorderBrush" Value="#3B82F6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <Style Selector="Button.move-edit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#CFE3F8"/>
                <Setter Property="BorderBrush" Value="#2860B0"/>
            </Style>
            <Style Selector="Button.move-edit:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#B5D2F2"/>
            </Style>
            <Style Selector="Path.move-edit-icon"><Setter Property="Fill" Value="#2860B0"/></Style>

            <!-- Chips de filtro del selector de movimientos: el activo se ve verde y en negrita -->
            <Style Selector="Button.method-chip">
                <Setter Property="Background" Value="#F3F4F6"/>
                <Setter Property="BorderBrush" Value="#D5D8DE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Foreground" Value="#1F2937"/>
            </Style>
            <Style Selector="Button.method-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#E6E8EC"/>
                <Setter Property="BorderBrush" Value="#B8BDC7"/>
            </Style>
            <Style Selector="Button.method-chip.active">
                <Setter Property="Background" Value="#1D9E75"/>
                <Setter Property="BorderBrush" Value="#15805D"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style Selector="Button.method-chip.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#188A66"/>
                <Setter Property="BorderBrush" Value="#15805D"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Botón "Corregir automáticamente" del tab Legal (llave inglesa) -->
            <Style Selector="Button.autofix">
                <Setter Property="Background" Value="#1D9E75"/>
                <Setter Property="BorderBrush" Value="#15805D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Button.autofix:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#188A66"/>
                <Setter Property="BorderBrush" Value="#15805D"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="Button.autofix:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#127556"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="Path.autofix-icon"><Setter Property="Fill" Value="White"/></Style>

            <Style Selector="Border.statrow Button">
                <Setter Property="MinHeight" Value="0"/>
            </Style>
            <Style Selector="Border.statrow TextBox">
                <Setter Property="MinHeight" Value="0"/>
            </Style>
            <Style Selector="RepeatButton.tab-arrow">
                <Setter Property="Width" Value="22"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="RepeatButton.tab-arrow:disabled Path">
                <Setter Property="Opacity" Value="0.3"/>
            </Style>
            <Style Selector="TabItem">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="MinWidth" Value="0"/>
                <!-- Separador vertical plomo a la derecha de cada pestaña (sin línea inferior continua). -->
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="BorderBrush" Value="#D5D8DE"/>
                <!-- Sin estirarse a todo el alto de la franja: el separador mide poco más que el texto. -->
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TabItem:selected">
                <Setter Property="BorderBrush" Value="#D5D8DE"/>
            </Style>

            <!-- Tarjetas del tab Special: resaltado cuando la mecánica está aplicada
                 (ver PokemonEditorViewModel.MegaCompatible/ZMoveCompatible/DynamaxActive/AlphaActive) -->
            <Style Selector="Border.special-active">
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
            <Style Selector="Border.dynamax-active">
                <Setter Property="BorderBrush" Value="#C23B4A"/>
            </Style>
            <Style Selector="Border.alpha-active">
                <Setter Property="BorderBrush" Value="#7A1530"/>
            </Style>

            <!-- Tarjetas del tab Ribbons: tamaño normal (7 tarjetas apiladas, filtro "Todas")
                 vs. expandido (una sola tarjeta visible, filtro por categoría específica).
                 Ajustado para alinearse al formato del resto de tabs: header en SemiBold
                 (como Learnsets/Sets/Special), más redondeado (10 en vez de 6). -->
            <Style Selector="Border.ribbon-card">
                <Setter Property="Padding" Value="8,6"/>
            </Style>
            <Style Selector="Border.ribbon-card.expanded">
                <Setter Property="Padding" Value="12,10"/>
            </Style>
            <Style Selector="Border.ribbon-card TextBlock.ribbon-header">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style Selector="Border.ribbon-card.expanded TextBlock.ribbon-header">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style Selector="Border.ribbon-card TextBlock.ribbon-count">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Opacity" Value="0.7"/>
            </Style>
            <Style Selector="Border.ribbon-card.expanded TextBlock.ribbon-count">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Opacity" Value="0.7"/>
            </Style>
            <Style Selector="Border.ribbon-card ItemsControl.ribbon-items">
                <Setter Property="Margin" Value="-3,5,-3,0"/>
            </Style>
            <Style Selector="Border.ribbon-card.expanded ItemsControl.ribbon-items">
                <Setter Property="Margin" Value="-3,7,-3,0"/>
            </Style>
            <!-- Tarjeta-medalla: sin chrome del ToggleButton; el aspecto lo dan los Border/Rectangle del template -->
            <Style Selector="ToggleButton.ribbon-tile">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="Border.ribbon-card.expanded ToggleButton.ribbon-tile">
                <Setter Property="MinHeight" Value="46"/>
            </Style>
            <Style Selector="Border.ribbon-card TextBlock.ribbon-tile-text">
                <Setter Property="FontSize" Value="10"/>
            </Style>
            <Style Selector="Border.ribbon-card.expanded TextBlock.ribbon-tile-text">
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <!-- Encabezado de la tarjeta: botón transparente (plegar/desplegar) -->
            <Style Selector="Button.ribbon-head">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style Selector="Button.ribbon-head:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="Border.ribbon-card.collapsed Path.ribbon-chevron">
                <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
            </Style>

            <!-- Tab IVs/EVs (mockup ivs-evs-layout): fila resaltada, etiquetas del radar y deltas -->
            <Style Selector="Border.statrow.hot">
                <Setter Property="Background" Value="#1F1D9E75"/>
            </Style>
            <Style Selector="TextBlock.statlbl">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
            <Style Selector="TextBlock.statlbl.hot">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <Style Selector="TextBlock.statlbl.up">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#1D9E75"/>
            </Style>
            <Style Selector="TextBlock.statlbl.down">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#D6455D"/>
            </Style>
            <Style Selector="Line.axis">
                <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
                <Setter Property="StrokeThickness" Value="0.5"/>
                <Setter Property="Opacity" Value="0.35"/>
            </Style>
            <Style Selector="Line.axis.hot">
                <Setter Property="Stroke" Value="#1D9E75"/>
                <Setter Property="StrokeThickness" Value="1.2"/>
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="TextBlock.delta.gain"><Setter Property="Foreground" Value="#1D9E75"/></Style>
            <Style Selector="TextBlock.delta.loss"><Setter Property="Foreground" Value="#D6455D"/></Style>
            <Style Selector="Border.evfill.over"><Setter Property="Background" Value="#D6455D"/></Style>
            <Style Selector="TextBlock.evvalue.over"><Setter Property="Foreground" Value="#D6455D"/></Style>
        </TabControl.Styles>

        <!-- ══════════════════════════════════════════════════════════
             Tab 1 — IVs / EVs
        ══════════════════════════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Loc[Tab_IvsEvs]}" VerticalAlignment="Center"/>
                    <Border Width="12" Height="12" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.2"
                            VerticalAlignment="Center" IsVisible="{Binding HasIvsEvsIssue}">
                        <TextBlock Text="!" FontSize="8" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="8"/>
                    </Border>
                </StackPanel>
            </TabItem.Header>
            <Grid RowDefinitions="Auto,*,Auto" Margin="8,-6,0,0">
                <StackPanel Grid.Row="0" IsVisible="{Binding HasBaseStats}" Margin="0,0,18,0">
                    <!-- Leyenda en una sola fila -->
                    <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="22" Height="3" Background="#1D9E75" VerticalAlignment="Center"/><TextBlock Text="{Binding Loc[Stats_Current]}" FontSize="11" Opacity="0.7"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Loc[Stats_Base_Tip]}"><Line StartPoint="0,1.5" EndPoint="22,1.5" Stroke="#9AA0A8" StrokeThickness="1.5" StrokeDashArray="3,2" VerticalAlignment="Center"/><TextBlock Text="{Binding Loc[Stats_Base]}" FontSize="11" Opacity="0.7"/></StackPanel>
                    </StackPanel>

                    <!-- Poder Oculto (izquierda) | radar | Naturaleza (derecha). Si la generación no los
                         soporta se atenúan en vez de ocultarse (BoolToOpacityConverter), como el resto de campos. -->
                    <Grid ColumnDefinitions="80,*,80" Margin="0,12,0,8">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2"
                                    Opacity="{Binding ShowHiddenPower, Converter={StaticResource BoolToOpacityConverter}}">
                            <TextBlock Text="{Binding Loc[Stats_HiddenPower]}" FontSize="10" Opacity="0.7"/>
                            <TextBlock Text="{Binding HiddenPowerType, Converter={StaticResource TypeNameConverter}}" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>

                        <Grid Grid.Column="1" HorizontalAlignment="Center">
                            <Canvas Width="170" Height="170">
                            <Polyline Points="85.0,12.0 148.2,48.5 148.2,121.5 85.0,158.0 21.8,121.5 21.8,48.5" Stroke="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" StrokeThickness="0.5" Fill="Transparent" Opacity="0.5"/>
                            <Polyline Points="85.0,30.2 132.4,57.6 132.4,112.4 85.0,139.8 37.6,112.4 37.6,57.6" Stroke="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" StrokeThickness="0.4" Fill="Transparent" Opacity="0.4"/>
                            <Polyline Points="85.0,48.5 116.6,66.7 116.6,103.2 85.0,121.5 53.4,103.2 53.4,66.8" Stroke="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" StrokeThickness="0.4" Fill="Transparent" Opacity="0.3"/>
                            <Polyline Points="85.0,66.8 100.8,75.9 100.8,94.1 85.0,103.2 69.2,94.1 69.2,75.9" Stroke="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" StrokeThickness="0.3" Fill="Transparent" Opacity="0.3"/>
                            <Line Classes="axis" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" StartPoint="85,85" EndPoint="85.0,12.0"/>
                            <Line Classes="axis" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" StartPoint="85,85" EndPoint="148.2,48.5"/>
                            <Line Classes="axis" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}" StartPoint="85,85" EndPoint="148.2,121.5"/>
                            <Line Classes="axis" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}" StartPoint="85,85" EndPoint="85.0,158.0"/>
                            <Line Classes="axis" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}" StartPoint="85,85" EndPoint="21.8,121.5"/>
                            <Line Classes="axis" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}" StartPoint="85,85" EndPoint="21.8,48.5"/>
                            <Polygon StrokeThickness="1.2" Fill="Transparent" Stroke="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.6" StrokeDashArray="3,2">
                                <Polygon.Points>
                                    <MultiBinding Converter="{StaticResource RadarPointsConverter}">
                                        <Binding Path="RadarBaseHp"/>
                                        <Binding Path="RadarBaseAtk"/>
                                        <Binding Path="RadarBaseDef"/>
                                        <Binding Path="RadarBaseSpe"/>
                                        <Binding Path="RadarBaseSpd"/>
                                        <Binding Path="RadarBaseSpa"/>
                                    </MultiBinding>
                                </Polygon.Points>
                            </Polygon>
                            <Polygon StrokeThickness="1.8" Fill="#331D9E75" Stroke="#1D9E75" >
                                <Polygon.Points>
                                    <MultiBinding Converter="{StaticResource RadarPointsConverter}">
                                        <Binding Path="RadarHp"/>
                                        <Binding Path="RadarAtk"/>
                                        <Binding Path="RadarDef"/>
                                        <Binding Path="RadarSpe"/>
                                        <Binding Path="RadarSpd"/>
                                        <Binding Path="RadarSpa"/>
                                    </MultiBinding>
                                </Polygon.Points>
                            </Polygon>
                            <StackPanel Canvas.Left="77" Canvas.Top="-12" Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Loc[Stat_Short_HP]}" Classes="statlbl" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                            </StackPanel>
                            <StackPanel Canvas.Left="152" Canvas.Top="35" Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Loc[Stat_Short_Atk]}" Classes="statlbl" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" Classes.up="{Binding NatUpAtk}" Classes.down="{Binding NatDownAtk}"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#1D9E75" VerticalAlignment="Center" IsVisible="{Binding NatUpAtk}">
                                    <TextBlock Text="+" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#D6455D" VerticalAlignment="Center" IsVisible="{Binding NatDownAtk}">
                                    <TextBlock Text="−" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Canvas.Left="152" Canvas.Top="122" Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Loc[Stat_Short_Def]}" Classes="statlbl" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}" Classes.up="{Binding NatUpDef}" Classes.down="{Binding NatDownDef}"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#1D9E75" VerticalAlignment="Center" IsVisible="{Binding NatUpDef}">
                                    <TextBlock Text="+" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#D6455D" VerticalAlignment="Center" IsVisible="{Binding NatDownDef}">
                                    <TextBlock Text="−" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Canvas.Left="77" Canvas.Top="166" Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Loc[Stat_Short_Spe]}" Classes="statlbl" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}" Classes.up="{Binding NatUpSpe}" Classes.down="{Binding NatDownSpe}"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#1D9E75" VerticalAlignment="Center" IsVisible="{Binding NatUpSpe}">
                                    <TextBlock Text="+" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#D6455D" VerticalAlignment="Center" IsVisible="{Binding NatDownSpe}">
                                    <TextBlock Text="−" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Canvas.Left="4" Canvas.Top="122" Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Loc[Stat_Short_SpD]}" Classes="statlbl" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}" Classes.up="{Binding NatUpSpd}" Classes.down="{Binding NatDownSpd}"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#1D9E75" VerticalAlignment="Center" IsVisible="{Binding NatUpSpd}">
                                    <TextBlock Text="+" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#D6455D" VerticalAlignment="Center" IsVisible="{Binding NatDownSpd}">
                                    <TextBlock Text="−" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Canvas.Left="4" Canvas.Top="35" Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Loc[Stat_Short_SpA]}" Classes="statlbl" Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}" Classes.up="{Binding NatUpSpa}" Classes.down="{Binding NatDownSpa}"/>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#1D9E75" VerticalAlignment="Center" IsVisible="{Binding NatUpSpa}">
                                    <TextBlock Text="+" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                                <Border Width="12" Height="12" CornerRadius="6" Background="#D6455D" VerticalAlignment="Center" IsVisible="{Binding NatDownSpa}">
                                    <TextBlock Text="−" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/>
                                </Border>
                            </StackPanel>
                                <!-- Puntos del radar (verde = sube/igual, rojo = baja vs. el save) + zona de hover cruzado -->
                                <ItemsControl Canvas.Left="0" Canvas.Top="0" Width="170" Height="170" ItemsSource="{Binding RadarVertices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Panel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RadarVertexInfo">
                                            <Border Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="{Binding BoxMargin}" Background="Transparent"
                                                    PointerEntered="OnRadarVertexPointerEntered" PointerExited="OnStatRowPointerExited">
                                                <Grid>
                                                    <Ellipse Width="22" Height="22" Fill="#1D9E75" Opacity="0.22" IsVisible="{Binding IsHot}"/>
                                                    <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2"
                                    Opacity="{Binding ShowNatures, Converter={StaticResource BoolToOpacityConverter}}">
                            <TextBlock Text="{Binding Loc[Stats_Nature]}" FontSize="10" Opacity="0.7" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SelectedNature.LocalizedName}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding NatureModsDisplay}" FontSize="9" Opacity="0.6" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Barras del stat justo bajo el radar (nombre a la izquierda, barras a la derecha) -->
                    <StackPanel Spacing="0" Margin="0,0,0,2">
                    <Border Classes="statrow" Tag="0" Padding="0,1"
                            Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                            PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited">
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_HP]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <!-- Verde = valor actual · verde claro = ganado vs. el save · rojo = perdido -->
                                <Grid Height="8">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarHp.FillWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarHp.GainWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarHp.LossWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarHp.RestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D9E75" CornerRadius="3,0,0,3"/>
                                        <Border Grid.Column="1" Background="#86DCBD"/>
                                        <Border Grid.Column="2" Background="#D6455D" Opacity="0.85"/>
                                    </Grid>
                                </Grid>
                                <!-- Gris = stat base de la especie (75% del alto de la verde) -->
                                <Grid Height="6">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarHp.BaseWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarHp.BaseRestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7D848E" CornerRadius="3,0,0,3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="statrow" Tag="1" Padding="0,1"
                            Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                            PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited">
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_Atk]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <!-- Verde = valor actual · verde claro = ganado vs. el save · rojo = perdido -->
                                <Grid Height="8">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarAtk.FillWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarAtk.GainWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarAtk.LossWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarAtk.RestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D9E75" CornerRadius="3,0,0,3"/>
                                        <Border Grid.Column="1" Background="#86DCBD"/>
                                        <Border Grid.Column="2" Background="#D6455D" Opacity="0.85"/>
                                    </Grid>
                                </Grid>
                                <!-- Gris = stat base de la especie (75% del alto de la verde) -->
                                <Grid Height="6">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarAtk.BaseWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarAtk.BaseRestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7D848E" CornerRadius="3,0,0,3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="statrow" Tag="2" Padding="0,1"
                            Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                            PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited">
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_Def]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <!-- Verde = valor actual · verde claro = ganado vs. el save · rojo = perdido -->
                                <Grid Height="8">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarDef.FillWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarDef.GainWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarDef.LossWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarDef.RestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D9E75" CornerRadius="3,0,0,3"/>
                                        <Border Grid.Column="1" Background="#86DCBD"/>
                                        <Border Grid.Column="2" Background="#D6455D" Opacity="0.85"/>
                                    </Grid>
                                </Grid>
                                <!-- Gris = stat base de la especie (75% del alto de la verde) -->
                                <Grid Height="6">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarDef.BaseWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarDef.BaseRestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7D848E" CornerRadius="3,0,0,3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="statrow" Tag="5" IsVisible="{Binding IsGen1}" Padding="0,1"
                            Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}"
                            PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited">
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_Spc]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <!-- Verde = valor actual · verde claro = ganado vs. el save · rojo = perdido -->
                                <Grid Height="8">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarSpa.FillWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpa.GainWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpa.LossWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpa.RestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D9E75" CornerRadius="3,0,0,3"/>
                                        <Border Grid.Column="1" Background="#86DCBD"/>
                                        <Border Grid.Column="2" Background="#D6455D" Opacity="0.85"/>
                                    </Grid>
                                </Grid>
                                <!-- Gris = stat base de la especie (75% del alto de la verde) -->
                                <Grid Height="6">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarSpa.BaseWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpa.BaseRestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7D848E" CornerRadius="3,0,0,3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="statrow" Tag="5" IsVisible="{Binding !IsGen1}" Padding="0,1"
                            Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}"
                            PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited">
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_SpA]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <!-- Verde = valor actual · verde claro = ganado vs. el save · rojo = perdido -->
                                <Grid Height="8">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarSpa.FillWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpa.GainWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpa.LossWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpa.RestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D9E75" CornerRadius="3,0,0,3"/>
                                        <Border Grid.Column="1" Background="#86DCBD"/>
                                        <Border Grid.Column="2" Background="#D6455D" Opacity="0.85"/>
                                    </Grid>
                                </Grid>
                                <!-- Gris = stat base de la especie (75% del alto de la verde) -->
                                <Grid Height="6">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarSpa.BaseWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpa.BaseRestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7D848E" CornerRadius="3,0,0,3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="statrow" Tag="4" IsVisible="{Binding !IsGen1}" Padding="0,1"
                            Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}"
                            PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited">
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_SpD]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <!-- Verde = valor actual · verde claro = ganado vs. el save · rojo = perdido -->
                                <Grid Height="8">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarSpd.FillWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpd.GainWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpd.LossWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpd.RestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D9E75" CornerRadius="3,0,0,3"/>
                                        <Border Grid.Column="1" Background="#86DCBD"/>
                                        <Border Grid.Column="2" Background="#D6455D" Opacity="0.85"/>
                                    </Grid>
                                </Grid>
                                <!-- Gris = stat base de la especie (75% del alto de la verde) -->
                                <Grid Height="6">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarSpd.BaseWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpd.BaseRestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7D848E" CornerRadius="3,0,0,3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="statrow" Tag="3" Padding="0,1"
                            Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                            PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited">
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_Spe]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <!-- Verde = valor actual · verde claro = ganado vs. el save · rojo = perdido -->
                                <Grid Height="8">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarSpe.FillWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpe.GainWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpe.LossWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpe.RestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1D9E75" CornerRadius="3,0,0,3"/>
                                        <Border Grid.Column="1" Background="#86DCBD"/>
                                        <Border Grid.Column="2" Background="#D6455D" Opacity="0.85"/>
                                    </Grid>
                                </Grid>
                                <!-- Gris = stat base de la especie (75% del alto de la verde) -->
                                <Grid Height="6">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding RowBarSpe.BaseWidth, Converter={StaticResource StarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding RowBarSpe.BaseRestWidth, Converter={StaticResource StarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7D848E" CornerRadius="3,0,0,3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Lista de stats: scrollea sola; el radar de arriba queda fijo -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,2,18,8" Spacing="3" HorizontalAlignment="Stretch">

                        <!-- ── Editor de stats: steppers conectados, alineados en una sola
                             grilla de columnas compartida (antes header y filas usaban Grids
                             "Auto" independientes, lo que desalineaba "IV"/"EV"/"Total" respecto
                             a los controles de abajo). 5 filas en Gen1 (Especial reemplaza a
                             Ataque Esp./Defensa Esp.), 6 filas en el resto.
                             Margen derecho del StackPanel subido a 18px (antes 8px) — el scrollbar
                             de la derecha se dibuja encima del contenido, no reserva su propio
                             espacio, así que la columna Total quedaba tapada. ────────────────── -->
                        <Grid ColumnDefinitions="28,*,*,34" Margin="4,0,4,4">
                            <TextBlock Grid.Column="1" Text="{Binding Loc[Stats_IV]}"    FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Loc[Stats_EV]}"    FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Loc[Stats_Total]}" FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- PS -->
                        <Border Classes="statrow" Tag="0" 
                                Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited"
                                GotFocus="OnStatRowGotFocus" LostFocus="OnStatRowLostFocus">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="28,*,*,34" Background="#0D000000" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_HP]}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1"
                                            IsEnabled="{Binding !UsesLegacyIVs}"
                                            Opacity="{Binding !UsesLegacyIVs, Converter={StaticResource BoolToOpacityConverter}}"
                                            ToolTip.Tip="{Binding HpIvTooltip}" ToolTip.ShowOnDisabled="True">
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="IvHp:0:31" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding IvHp}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="IvHp:0:31"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="IvHp:0:31" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="IvHp:0:31" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='IV_HP'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Button Content="{Binding Loc[Stats_Min]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#1D9E75" Tag="EvHp:0:252" Click="OnSpinnerMin"/>
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="EvHp:0:252" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding EvHp}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="EvHp:0:252"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="EvHp:0:252" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="EvHp:0:252" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='EV_HP'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TotalHp}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Classes="delta" Classes.gain="{Binding RowBarHp.IsGain}" Classes.loss="{Binding RowBarHp.IsLoss}"
                                               Text="{Binding RowBarHp.DeltaText}" FontSize="8" Height="9" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Atq -->
                        <Border Classes="statrow" Tag="1" 
                                Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited"
                                GotFocus="OnStatRowGotFocus" LostFocus="OnStatRowLostFocus">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="28,*,*,34" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_Atk]}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="IvAtk:0:31" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding IvAtk}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="IvAtk:0:31"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="IvAtk:0:31" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="IvAtk:0:31" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='IV_ATK'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Button Content="{Binding Loc[Stats_Min]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#1D9E75" Tag="EvAtk:0:252" Click="OnSpinnerMin"/>
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="EvAtk:0:252" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding EvAtk}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="EvAtk:0:252"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="EvAtk:0:252" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="EvAtk:0:252" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='EV_ATK'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TotalAtk}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Classes="delta" Classes.gain="{Binding RowBarAtk.IsGain}" Classes.loss="{Binding RowBarAtk.IsLoss}"
                                               Text="{Binding RowBarAtk.DeltaText}" FontSize="8" Height="9" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Def -->
                        <Border Classes="statrow" Tag="2" 
                                Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited"
                                GotFocus="OnStatRowGotFocus" LostFocus="OnStatRowLostFocus">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="28,*,*,34" Background="#0D000000" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_Def]}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="IvDef:0:31" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding IvDef}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="IvDef:0:31"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="IvDef:0:31" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="IvDef:0:31" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='IV_DEF'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Button Content="{Binding Loc[Stats_Min]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#1D9E75" Tag="EvDef:0:252" Click="OnSpinnerMin"/>
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="EvDef:0:252" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding EvDef}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="EvDef:0:252"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="EvDef:0:252" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="EvDef:0:252" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='EV_DEF'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TotalDef}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Classes="delta" Classes.gain="{Binding RowBarDef.IsGain}" Classes.loss="{Binding RowBarDef.IsLoss}"
                                               Text="{Binding RowBarDef.DeltaText}" FontSize="8" Height="9" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Esp (solo Gen 1 — reemplaza a AtqE/DefE, misma stat "Special") -->
                        <Border Classes="statrow" Tag="5" IsVisible="{Binding IsGen1}"
                                Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}"
                                PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited"
                                GotFocus="OnStatRowGotFocus" LostFocus="OnStatRowLostFocus">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="28,*,*,34" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_Spc]}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="IvSpa:0:31" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding IvSpa}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="IvSpa:0:31"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="IvSpa:0:31" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="IvSpa:0:31" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='IV_SPA'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Button Content="{Binding Loc[Stats_Min]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#1D9E75" Tag="EvSpa:0:252" Click="OnSpinnerMin"/>
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="EvSpa:0:252" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding EvSpa}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="EvSpa:0:252"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
