                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='EV_SPA'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TotalSpa}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Classes="delta" Classes.gain="{Binding RowBarSpa.IsGain}" Classes.loss="{Binding RowBarSpa.IsLoss}"
                                               Text="{Binding RowBarSpa.DeltaText}" FontSize="8" Height="9" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- AtqE (Gen 2+, oculto en Gen 1) -->
                        <Border Classes="statrow" Tag="5" IsVisible="{Binding !IsGen1}"
                                Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}"
                                PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited"
                                GotFocus="OnStatRowGotFocus" LostFocus="OnStatRowLostFocus">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="28,*,*,34" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_SpA]}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="IvSpa:0:31" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding IvSpa}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="IvSpa:0:31"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="IvSpa:0:31" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="IvSpa:0:31" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='IV_SPA'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Button Content="{Binding Loc[Stats_Min]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#1D9E75" Tag="EvSpa:0:252" Click="OnSpinnerMin"/>
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="EvSpa:0:252" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding EvSpa}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="EvSpa:0:252"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="EvSpa:0:252" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="EvSpa:0:252" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='EV_SPA'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TotalSpa}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Classes="delta" Classes.gain="{Binding RowBarSpa.IsGain}" Classes.loss="{Binding RowBarSpa.IsLoss}"
                                               Text="{Binding RowBarSpa.DeltaText}" FontSize="8" Height="9" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- DefE (Gen 2+, oculto en Gen 1) -->
                        <Border Classes="statrow" Tag="4" IsVisible="{Binding !IsGen1}"
                                Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}"
                                PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited"
                                GotFocus="OnStatRowGotFocus" LostFocus="OnStatRowLostFocus">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="28,*,*,34" Background="#0D000000" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_SpD]}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="IvSpd:0:31" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding IvSpd}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="IvSpd:0:31"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="IvSpd:0:31" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="IvSpd:0:31" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='IV_SPD'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Button Content="{Binding Loc[Stats_Min]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#1D9E75" Tag="EvSpd:0:252" Click="OnSpinnerMin"/>
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="EvSpd:0:252" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding EvSpd}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="EvSpd:0:252"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="EvSpd:0:252" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="EvSpd:0:252" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='EV_SPD'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TotalSpd}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Classes="delta" Classes.gain="{Binding RowBarSpd.IsGain}" Classes.loss="{Binding RowBarSpd.IsLoss}"
                                               Text="{Binding RowBarSpd.DeltaText}" FontSize="8" Height="9" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Vel -->
                        <Border Classes="statrow" Tag="3" 
                                Classes.hot="{Binding HoveredStat, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                PointerEntered="OnStatRowPointerEntered" PointerExited="OnStatRowPointerExited"
                                GotFocus="OnStatRowGotFocus" LostFocus="OnStatRowLostFocus">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="28,*,*,34" Margin="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Stat_Short_Spe]}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="IvSpe:0:31" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding IvSpe}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="IvSpe:0:31"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="IvSpe:0:31" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="IvSpe:0:31" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='IV_SPE'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1">
                                    <Button Content="{Binding Loc[Stats_Min]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#1D9E75" Tag="EvSpe:0:252" Click="OnSpinnerMin"/>
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Content="−" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="6,0,0,6"
                                                    Tag="EvSpe:0:252" Click="OnSpinnerDecrement"/>
                                            <TextBox Text="{Binding EvSpe}" FontSize="10" Width="26" Height="20" BorderThickness="0"
                                                     TextAlignment="Center" Padding="0" VerticalContentAlignment="Center"
                                                     LostFocus="OnSpinnerTextChanged" Tag="EvSpe:0:252"/>
                                            <Button Content="+" FontSize="9" Padding="0" Width="18" Height="20" CornerRadius="0,6,6,0"
                                                    Tag="EvSpe:0:252" Click="OnSpinnerIncrement"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="{Binding Loc[Stats_Max]}" FontSize="8" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="#1D9E75" Tag="EvSpe:0:252" Click="OnSpinnerMax"/>
                                    <Border Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='EV_SPE'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TotalSpe}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Classes="delta" Classes.gain="{Binding RowBarSpe.IsGain}" Classes.loss="{Binding RowBarSpe.IsLoss}"
                                               Text="{Binding RowBarSpe.DeltaText}" FontSize="8" Height="9" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>



                        <!-- ── Etapa 4.6.5 — suma de EVs. EvTotal/EvTotalDisplay son propiedades
                             calculadas (sin backing field), refrescadas en cada RecalcStats
                             (o sea, en cada cambio de cualquiera de las 6 EVs de arriba). El
                             resaltado usa el mismo FieldHighlightConverter que ya usan los 12
                             TextBox de IV/EV, con ConverterParameter="EV_TOTAL" — el FieldId que
                             emite LegalityEvFormatter cuando la suma pasa de 510. En Gen1/Gen2 el
                             valor se sigue mostrando (es informativo), pero nunca se va a resaltar
                             solo, porque ese chequeo de PKHeX no existe para esos formatos. ────── -->
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Stats_TotalEvs]}" FontSize="10" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="6,4"/>
                            <Border Grid.Column="1" Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" VerticalAlignment="Center" Margin="2,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='EV_TOTAL'}"><TextBlock Text="!" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="11"/></Border>
                            <!-- Medidor 0-510 (solo Gen 3+; en Gen 1/2 no hay tope combinado) -->
                            <Grid Grid.Column="2" Height="5" Margin="8,0" VerticalAlignment="Center" IsVisible="{Binding !UsesLegacyIVs}">
                                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding EvMeterFill, Converter={StaticResource StarWidthConverter}}"/>
                                        <ColumnDefinition Width="{Binding EvMeterRest, Converter={StaticResource StarWidthConverter}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Classes="evfill" Classes.over="{Binding EvTotalOver}" Background="#1D9E75" CornerRadius="3,0,0,3"/>
                                </Grid>
                            </Grid>
                            <TextBlock Grid.Column="3" Classes="evvalue" Classes.over="{Binding EvTotalOver}" Text="{Binding EvTotalDisplay}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,4,6,4"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Aviso "Buscar IVs legales" (mockups/ivs_solver_modal/) ── Franja fija al pie del tab
                     (la lista de arriba conserva su scroll). SOLO aparece cuando los IVs editados rompen la
                     semilla del encuentro y existe una búsqueda que lo puede resolver
                     (PokemonEditorViewModel.IvSolverAvailable); se apaga sola cuando el Pokémon vuelve a ser
                     legal. Sin alerta de legalidad no hay nada nuevo en pantalla. -->
                <Border Grid.Row="2" IsVisible="{Binding IvSolverAvailable}" Margin="0,6,10,0" Padding="8,6"
                        Background="#FFF4EC" BorderBrush="#F1C7A8" BorderThickness="1" CornerRadius="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="3" Background="#E30909"
                                BorderBrush="#7A0000" BorderThickness="1.2" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="!" FontSize="10" FontWeight="Black" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding IvSolverBannerText}" FontSize="11" Foreground="#7C2D05"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="{Binding IvSolverBannerButton}" Command="{Binding OpenIvSolverCommand}"
                                Margin="8,0,0,0" Padding="10,4" FontSize="11" Background="#1C1C1F" Foreground="White"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ══════════════════════════════════════════════════════════
             Tab 2 — Movimientos
        ══════════════════════════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Loc[Tab_Moves]}" VerticalAlignment="Center"/>
                    <Border Width="12" Height="12" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.2"
                            VerticalAlignment="Center" IsVisible="{Binding HasMovesIssue}">
                        <TextBlock Text="!" FontSize="8" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="8"/>
                    </Border>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <!-- Contenido principal: leyenda + tarjetas de moves -->
                <DockPanel IsVisible="{Binding !IsMoveSelecting}">

                    <!-- Tarjetas de los 4 moves -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6" Margin="8">

                            <!-- Macro: cada slot tiene la misma estructura de 2 columnas:
                                 izquierda = cabecera (tipo/nombre/clase/editar) + efecto;
                                 derecha   = stats (Pwr/Acc) + PP con stepper de PP Ups -->

                            <!-- Slot 1 — tarjeta: franja del color del tipo + nombre + chip de clase; fila de stats
                                 (Power/Accuracy/barra de PP/PP Ups como puntos) y descripción. -->
                            <Border CornerRadius="10" Padding="0" ClipToBounds="True"
                                    IsVisible="{Binding !Move1IsEmpty}"
                                    Background="White"
                                    BorderBrush="{Binding Move1Class, Converter={StaticResource DamageClassToBorder}}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="8,*">
                                    <Border Grid.Column="0"
                                            Background="{Binding Move1Type, Converter={StaticResource TypeColorConverter}}"/>
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <Border Padding="10,7" Background="{Binding Move1Class, Converter={StaticResource DamageClassToBrush}}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Border Grid.Column="0" CornerRadius="4" Padding="7,1" Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Move1Type, Converter={StaticResource TypeColorConverter}}"
                                                        IsVisible="{Binding Move1Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Move1Type, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold" Foreground="{Binding Move1Type, Converter={StaticResource TypeTextColorConverter}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Move1}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="#99FFFFFF"
                                                        BorderBrush="{Binding Move1Class, Converter={StaticResource DamageClassToBorder}}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                 Fill="{Binding Move1Class, Converter={StaticResource DamageClassDotConverter}}"/>
                                                        <TextBlock Text="{Binding Move1Class, Converter={StaticResource CapitalizeConverter}}"
                                                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Move1Class, Converter={StaticResource DamageClassDotConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="3" Classes="move-edit"
                                                        Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Tag="1" Click="OnOpenMoveSelector"
                                                        ToolTip.Tip="{Binding Loc[Moves_ChangeMove_Tip]}">
                                                            <Path Classes="move-edit-icon" Stretch="Uniform" Width="12" Height="12"
                                                                  Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"/>
                                                        </Button>
                                                <Border Grid.Column="4" Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='Move1'}"><TextBlock Text="!" FontSize="9" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/></Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Spacing="6" Margin="10,8,10,10">

                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Loc[Moves_Power]}" FontSize="9" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Move1Power, TargetNullValue='—'}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Loc[Moves_Accuracy]}" FontSize="9" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Move1Accuracy, TargetNullValue='—'}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Moves_PP]}" FontSize="9" Opacity="0.7"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Move1PP}" FontSize="9" Opacity="0.7"/>
                                                        <TextBlock Text=" / " FontSize="9" Opacity="0.7"/>
                                                        <TextBlock Text="{Binding Move1MaxPP}" FontSize="9" Opacity="0.7"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                        IsEnabled="{Binding Move1CanPPUp}"
                                                        Opacity="{Binding Move1CanPPUp, Converter={StaticResource BoolToOpacityConverter}}"
                                                        ToolTip.Tip="{Binding Loc[Moves_PpUps_Tip]}">
                                                <Button Content="−" FontSize="12" Width="22" Height="22" Padding="0"
                                                        Tag="Move1PPUps:0:3" Click="OnSpinnerDecrement"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move1PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=1}"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move1PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=2}"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move1PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=3}"/>
                                                <Button Content="+" FontSize="12" Width="22" Height="22" Padding="0"
                                                        Tag="Move1PPUps:0:3" Click="OnSpinnerIncrement"/>
                                            </StackPanel>
                                            <!-- Barra de PP: 1 segmento por PP, 64 en total (2 filas de 32), siempre del
                                                 mismo tamaño. Llenos = PP actual; tenue = hasta el máximo del movimiento. -->
                                            <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0"
                                                          ItemsSource="{Binding Move1PpSegments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="32"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PpSegment">
                                                        <Border Height="6" CornerRadius="1.5" Margin="0.75,1" Background="{Binding Brush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <TextBlock Text="{Binding Move1Effect}" FontSize="10" Opacity="0.65"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Slot 1 — "+" (solo si es el PRIMER slot vacío): reemplaza toda
                                 la tarjeta a medio llenar (badge/lápiz/Pwr/Acc/PP) por el mismo
                                 lenguaje visual del "+" de crear Pokémon en Caja/Equipo. Abre el
                                 mismo MoveSelectorViewModel que el lápiz — mismo Tag, mismo
                                 OnOpenMoveSelector, solo cambia el disparador visual. -->
                            <Button IsVisible="{Binding Move1IsCreateSlot}"
                                    Tag="1" Click="OnOpenMoveSelector"
                                    Height="56" HorizontalAlignment="Stretch"
                                    Background="Transparent" BorderThickness="1.5" CornerRadius="6"
                                    BorderBrush="#B4B2A9">
                                <TextBlock Text="+" FontSize="22" FontWeight="Light" Foreground="#8F8D82"/>
                            </Button>

                            <!-- Slot 1 — vacío pero no es el "+" (no debería pasar en la
                                 práctica para el slot 1, ya que si está vacío siempre es el
                                 primero — queda igual por consistencia con los otros 3). -->
                            <Border IsVisible="{Binding Move1ShowDash}"
                                    Height="56">
                                <TextBlock Text="—" FontSize="14" Opacity="0.3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Slot 2 — tarjeta: franja del color del tipo + nombre + chip de clase; fila de stats
                                 (Power/Accuracy/barra de PP/PP Ups como puntos) y descripción. -->
                            <Border CornerRadius="10" Padding="0" ClipToBounds="True"
                                    IsVisible="{Binding !Move2IsEmpty}"
                                    Background="White"
                                    BorderBrush="{Binding Move2Class, Converter={StaticResource DamageClassToBorder}}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="8,*">
                                    <Border Grid.Column="0"
                                            Background="{Binding Move2Type, Converter={StaticResource TypeColorConverter}}"/>
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <Border Padding="10,7" Background="{Binding Move2Class, Converter={StaticResource DamageClassToBrush}}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Border Grid.Column="0" CornerRadius="4" Padding="7,1" Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Move2Type, Converter={StaticResource TypeColorConverter}}"
                                                        IsVisible="{Binding Move2Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Move2Type, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold" Foreground="{Binding Move2Type, Converter={StaticResource TypeTextColorConverter}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Move2}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="#99FFFFFF"
                                                        BorderBrush="{Binding Move2Class, Converter={StaticResource DamageClassToBorder}}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                 Fill="{Binding Move2Class, Converter={StaticResource DamageClassDotConverter}}"/>
                                                        <TextBlock Text="{Binding Move2Class, Converter={StaticResource CapitalizeConverter}}"
                                                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Move2Class, Converter={StaticResource DamageClassDotConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="3" Classes="move-edit"
                                                        Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Tag="2" Click="OnOpenMoveSelector"
                                                        ToolTip.Tip="{Binding Loc[Moves_ChangeMove_Tip]}">
                                                            <Path Classes="move-edit-icon" Stretch="Uniform" Width="12" Height="12"
                                                                  Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"/>
                                                        </Button>
                                                <Border Grid.Column="4" Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='Move2'}"><TextBlock Text="!" FontSize="9" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/></Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Spacing="6" Margin="10,8,10,10">

                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Loc[Moves_Power]}" FontSize="9" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Move2Power, TargetNullValue='—'}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Loc[Moves_Accuracy]}" FontSize="9" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Move2Accuracy, TargetNullValue='—'}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Moves_PP]}" FontSize="9" Opacity="0.7"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Move2PP}" FontSize="9" Opacity="0.7"/>
                                                        <TextBlock Text=" / " FontSize="9" Opacity="0.7"/>
                                                        <TextBlock Text="{Binding Move2MaxPP}" FontSize="9" Opacity="0.7"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                        IsEnabled="{Binding Move2CanPPUp}"
                                                        Opacity="{Binding Move2CanPPUp, Converter={StaticResource BoolToOpacityConverter}}"
                                                        ToolTip.Tip="{Binding Loc[Moves_PpUps_Tip]}">
                                                <Button Content="−" FontSize="12" Width="22" Height="22" Padding="0"
                                                        Tag="Move2PPUps:0:3" Click="OnSpinnerDecrement"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move2PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=1}"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move2PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=2}"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move2PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=3}"/>
                                                <Button Content="+" FontSize="12" Width="22" Height="22" Padding="0"
                                                        Tag="Move2PPUps:0:3" Click="OnSpinnerIncrement"/>
                                            </StackPanel>
                                            <!-- Barra de PP: 1 segmento por PP, 64 en total (2 filas de 32), siempre del
                                                 mismo tamaño. Llenos = PP actual; tenue = hasta el máximo del movimiento. -->
                                            <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0"
                                                          ItemsSource="{Binding Move2PpSegments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="32"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PpSegment">
                                                        <Border Height="6" CornerRadius="1.5" Margin="0.75,1" Background="{Binding Brush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <TextBlock Text="{Binding Move2Effect}" FontSize="10" Opacity="0.65"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button IsVisible="{Binding Move2IsCreateSlot}"
                                    Tag="2" Click="OnOpenMoveSelector"
                                    Height="56" HorizontalAlignment="Stretch"
                                    Background="Transparent" BorderThickness="1.5" CornerRadius="6"
                                    BorderBrush="#B4B2A9">
                                <TextBlock Text="+" FontSize="22" FontWeight="Light" Foreground="#8F8D82"/>
                            </Button>
                            <Border IsVisible="{Binding Move2ShowDash}"
                                    Height="56">
                                <TextBlock Text="—" FontSize="14" Opacity="0.3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Slot 3 — tarjeta: franja del color del tipo + nombre + chip de clase; fila de stats
                                 (Power/Accuracy/barra de PP/PP Ups como puntos) y descripción. -->
                            <Border CornerRadius="10" Padding="0" ClipToBounds="True"
                                    IsVisible="{Binding !Move3IsEmpty}"
                                    Background="White"
                                    BorderBrush="{Binding Move3Class, Converter={StaticResource DamageClassToBorder}}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="8,*">
                                    <Border Grid.Column="0"
                                            Background="{Binding Move3Type, Converter={StaticResource TypeColorConverter}}"/>
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <Border Padding="10,7" Background="{Binding Move3Class, Converter={StaticResource DamageClassToBrush}}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Border Grid.Column="0" CornerRadius="4" Padding="7,1" Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Move3Type, Converter={StaticResource TypeColorConverter}}"
                                                        IsVisible="{Binding Move3Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Move3Type, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold" Foreground="{Binding Move3Type, Converter={StaticResource TypeTextColorConverter}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Move3}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="#99FFFFFF"
                                                        BorderBrush="{Binding Move3Class, Converter={StaticResource DamageClassToBorder}}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                 Fill="{Binding Move3Class, Converter={StaticResource DamageClassDotConverter}}"/>
                                                        <TextBlock Text="{Binding Move3Class, Converter={StaticResource CapitalizeConverter}}"
                                                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Move3Class, Converter={StaticResource DamageClassDotConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="3" Classes="move-edit"
                                                        Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Tag="3" Click="OnOpenMoveSelector"
                                                        ToolTip.Tip="{Binding Loc[Moves_ChangeMove_Tip]}">
                                                            <Path Classes="move-edit-icon" Stretch="Uniform" Width="12" Height="12"
                                                                  Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"/>
                                                        </Button>
                                                <Border Grid.Column="4" Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='Move3'}"><TextBlock Text="!" FontSize="9" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/></Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Spacing="6" Margin="10,8,10,10">

                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Loc[Moves_Power]}" FontSize="9" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Move3Power, TargetNullValue='—'}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Loc[Moves_Accuracy]}" FontSize="9" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Move3Accuracy, TargetNullValue='—'}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Moves_PP]}" FontSize="9" Opacity="0.7"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Move3PP}" FontSize="9" Opacity="0.7"/>
                                                        <TextBlock Text=" / " FontSize="9" Opacity="0.7"/>
                                                        <TextBlock Text="{Binding Move3MaxPP}" FontSize="9" Opacity="0.7"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                        IsEnabled="{Binding Move3CanPPUp}"
                                                        Opacity="{Binding Move3CanPPUp, Converter={StaticResource BoolToOpacityConverter}}"
                                                        ToolTip.Tip="{Binding Loc[Moves_PpUps_Tip]}">
                                                <Button Content="−" FontSize="12" Width="22" Height="22" Padding="0"
                                                        Tag="Move3PPUps:0:3" Click="OnSpinnerDecrement"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move3PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=1}"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move3PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=2}"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move3PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=3}"/>
                                                <Button Content="+" FontSize="12" Width="22" Height="22" Padding="0"
                                                        Tag="Move3PPUps:0:3" Click="OnSpinnerIncrement"/>
                                            </StackPanel>
                                            <!-- Barra de PP: 1 segmento por PP, 64 en total (2 filas de 32), siempre del
                                                 mismo tamaño. Llenos = PP actual; tenue = hasta el máximo del movimiento. -->
                                            <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0"
                                                          ItemsSource="{Binding Move3PpSegments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="32"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PpSegment">
                                                        <Border Height="6" CornerRadius="1.5" Margin="0.75,1" Background="{Binding Brush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <TextBlock Text="{Binding Move3Effect}" FontSize="10" Opacity="0.65"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button IsVisible="{Binding Move3IsCreateSlot}"
                                    Tag="3" Click="OnOpenMoveSelector"
                                    Height="56" HorizontalAlignment="Stretch"
                                    Background="Transparent" BorderThickness="1.5" CornerRadius="6"
                                    BorderBrush="#B4B2A9">
                                <TextBlock Text="+" FontSize="22" FontWeight="Light" Foreground="#8F8D82"/>
                            </Button>
                            <Border IsVisible="{Binding Move3ShowDash}"
                                    Height="56">
                                <TextBlock Text="—" FontSize="14" Opacity="0.3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Slot 4 — tarjeta: franja del color del tipo + nombre + chip de clase; fila de stats
                                 (Power/Accuracy/barra de PP/PP Ups como puntos) y descripción. -->
                            <Border CornerRadius="10" Padding="0" ClipToBounds="True"
                                    IsVisible="{Binding !Move4IsEmpty}"
                                    Background="White"
                                    BorderBrush="{Binding Move4Class, Converter={StaticResource DamageClassToBorder}}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="8,*">
                                    <Border Grid.Column="0"
                                            Background="{Binding Move4Type, Converter={StaticResource TypeColorConverter}}"/>
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <Border Padding="10,7" Background="{Binding Move4Class, Converter={StaticResource DamageClassToBrush}}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Border Grid.Column="0" CornerRadius="4" Padding="7,1" Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Move4Type, Converter={StaticResource TypeColorConverter}}"
                                                        IsVisible="{Binding Move4Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding Move4Type, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold" Foreground="{Binding Move4Type, Converter={StaticResource TypeTextColorConverter}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Move4}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="#99FFFFFF"
                                                        BorderBrush="{Binding Move4Class, Converter={StaticResource DamageClassToBorder}}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                 Fill="{Binding Move4Class, Converter={StaticResource DamageClassDotConverter}}"/>
                                                        <TextBlock Text="{Binding Move4Class, Converter={StaticResource CapitalizeConverter}}"
                                                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Move4Class, Converter={StaticResource DamageClassDotConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="3" Classes="move-edit"
                                                        Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Tag="4" Click="OnOpenMoveSelector"
                                                        ToolTip.Tip="{Binding Loc[Moves_ChangeMove_Tip]}">
                                                            <Path Classes="move-edit-icon" Stretch="Uniform" Width="12" Height="12"
                                                                  Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"/>
                                                        </Button>
                                                <Border Grid.Column="4" Width="14" Height="14" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding HighlightedFieldIds, Converter={StaticResource FieldHighlightConverter}, ConverterParameter='Move4'}"><TextBlock Text="!" FontSize="9" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/></Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Spacing="6" Margin="10,8,10,10">

                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Loc[Moves_Power]}" FontSize="9" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Move4Power, TargetNullValue='—'}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Loc[Moves_Accuracy]}" FontSize="9" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Move4Accuracy, TargetNullValue='—'}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Moves_PP]}" FontSize="9" Opacity="0.7"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Move4PP}" FontSize="9" Opacity="0.7"/>
                                                        <TextBlock Text=" / " FontSize="9" Opacity="0.7"/>
                                                        <TextBlock Text="{Binding Move4MaxPP}" FontSize="9" Opacity="0.7"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                        IsEnabled="{Binding Move4CanPPUp}"
                                                        Opacity="{Binding Move4CanPPUp, Converter={StaticResource BoolToOpacityConverter}}"
                                                        ToolTip.Tip="{Binding Loc[Moves_PpUps_Tip]}">
                                                <Button Content="−" FontSize="12" Width="22" Height="22" Padding="0"
                                                        Tag="Move4PPUps:0:3" Click="OnSpinnerDecrement"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move4PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=1}"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move4PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=2}"/>
                                                <Ellipse Width="9" Height="9" Stroke="#888780" StrokeThickness="1.5" VerticalAlignment="Center"
                                                         Fill="{Binding Move4PPUps, Converter={StaticResource PpUpPipBrushConverter}, ConverterParameter=3}"/>
                                                <Button Content="+" FontSize="12" Width="22" Height="22" Padding="0"
                                                        Tag="Move4PPUps:0:3" Click="OnSpinnerIncrement"/>
                                            </StackPanel>
                                            <!-- Barra de PP: 1 segmento por PP, 64 en total (2 filas de 32), siempre del
                                                 mismo tamaño. Llenos = PP actual; tenue = hasta el máximo del movimiento. -->
                                            <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0"
                                                          ItemsSource="{Binding Move4PpSegments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="32"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PpSegment">
                                                        <Border Height="6" CornerRadius="1.5" Margin="0.75,1" Background="{Binding Brush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <TextBlock Text="{Binding Move4Effect}" FontSize="10" Opacity="0.65"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button IsVisible="{Binding Move4IsCreateSlot}"
                                    Tag="4" Click="OnOpenMoveSelector"
                                    Height="56" HorizontalAlignment="Stretch"
                                    Background="Transparent" BorderThickness="1.5" CornerRadius="6"
                                    BorderBrush="#B4B2A9">
                                <TextBlock Text="+" FontSize="22" FontWeight="Light" Foreground="#8F8D82"/>
                            </Button>
                            <Border IsVisible="{Binding Move4ShowDash}"
                                    Height="56">
                                <TextBlock Text="—" FontSize="14" Opacity="0.3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Panel de selección de movimiento (overlay) -->
                <!-- IsVisible en Grid externo (DataContext = PokemonEditorViewModel) -->
                <!-- DataContext cambia a MoveSelector solo en el Border interior -->
                <Grid IsVisible="{Binding IsMoveSelecting}">
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="1" CornerRadius="6" Margin="4"
                        DataContext="{Binding MoveSelector}">
                    <DockPanel Margin="10">

                        <!-- Header -->
                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SlotLabel}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <Button Grid.Column="1" Content="✕" FontSize="10"
                                        Width="22" Height="22" Padding="0"
                                        Click="OnCancelMoveSelection"/>
                            </Grid>

                            <!-- Buscador -->
                            <TextBox Watermark="{ReflectionBinding $parent[UserControl].DataContext.Loc[Moves_Search_Watermark]}"
                                     FontSize="10" Height="26" Padding="6,0"
                                     TextChanged="OnMoveSearchChanged"/>

                            <!-- Leyenda de clase de daño -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="7" Height="7" Fill="#C14A1A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Class_Physical]}" FontSize="9" Foreground="#C14A1A"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="7" Height="7" Fill="#2860B0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Class_Special]}" FontSize="9" Foreground="#2860B0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="7" Height="7" Fill="#4A8220" VerticalAlignment="Center"/>
                                    <TextBlock Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Class_Status]}" FontSize="9" Foreground="#4A8220"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Chips de filtro por método -->
                            <ItemsControl ItemsSource="{Binding AvailableMethods}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="method-chip" Classes.active="{Binding IsActive}"
                                                Content="{Binding Label}"
                                                FontSize="9" Padding="8,3" Margin="0,0,4,4"
                                                Tag="{Binding Label}"
                                                Click="OnMethodFilterClick"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Footer: botón Cancel -->
                        <Button DockPanel.Dock="Bottom" Content="{ReflectionBinding $parent[UserControl].DataContext.Loc[Action_Cancel]}"
                                FontSize="10" Height="26" Margin="0,8,0,0"
                                Click="OnCancelMoveSelection"/>

                        <!-- Cabecera de columnas -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,58,14,32,110" Margin="0,4,0,2">
                            <TextBlock Grid.Column="0" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Move]}"   FontSize="9" Opacity="0.5"/>
                            <TextBlock Grid.Column="1" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Type]}"   FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text=""        FontSize="9"/>
                            <TextBlock Grid.Column="3" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Power]}"   FontSize="9" Opacity="0.5" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Method]}" FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" BorderThickness="0,1,0,0" Opacity="0.2" Margin="0,0,0,2"/>

                        <!-- Lista de movimientos -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Filtered}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:MoveOption">
                                        <Border Padding="2,3" CornerRadius="3" Margin="0,1"
                                                Background="{Binding IsCurrent, Converter={StaticResource BoolToOpacityConverter}}"
                                                DoubleTapped="OnMoveRowDoubleTapped">
                                            <Grid ColumnDefinitions="*,58,14,32,110">
                                                <!-- Nombre -->
                                                <!-- La descripción (Acc/PP + efecto) se muestra como tooltip
                                                     al pasar el mouse por el nombre. -->
                                                <TextBlock Grid.Column="0" Text="{Binding MoveName}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Background="Transparent"
                                                           ToolTip.Tip="{Binding Tooltip}"/>
                                                <!-- Tipo -->
                                                <Border Grid.Column="1"
                                                        Background="{Binding TypeDisplay, Converter={StaticResource TypeColorConverter}}"
                                                        CornerRadius="3" Padding="3,1"
                                                        IsVisible="{Binding TypeDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeDisplay, Converter={StaticResource TypeNameConverter}}"
                                                               FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <!-- Clase de daño (punto de color) -->
                                                <Ellipse Grid.Column="2" Width="7" Height="7"
                                                         Fill="{Binding DamageClass, Converter={StaticResource DamageClassDotConverter}}"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <!-- Poder -->
                                                <TextBlock Grid.Column="3" Text="{Binding PowerDisplay}"
                                                           FontSize="10" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                                <!-- Método -->
                                                <TextBlock Grid.Column="4" Text="{Binding MethodDisplay}"
                                                           FontSize="9" Opacity="0.65"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding MethodTooltip}"
                                                           Background="Transparent"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </DockPanel>
                </Border>
                </Grid>
            </Grid>
        </TabItem>


        <!-- ══════════════════════════════════════════════════════════
             Tab 3 — Learnsets
        ══════════════════════════════════════════════════════════════ -->
        <TabItem Header="{Binding Loc[Tab_Learnsets]}" IsVisible="{Binding TabLearnsets}">
            <DockPanel>

                <!-- Leyenda fija arriba -->
                <Border DockPanel.Dock="Top"
                        BorderThickness="0,0,0,1" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="7" Height="7" Fill="#C14A1A" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Move_Class_Physical]}"   FontSize="10" Foreground="#C14A1A" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="7" Height="7" Fill="#2860B0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Move_Class_Special]}" FontSize="10" Foreground="#2860B0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="7" Height="7" Fill="#4A8220" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Move_Class_Status]}"   FontSize="10" Foreground="#4A8220" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Learnsets agrupados por método -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LearnsetGroups}" Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:LearnsetGroup">
                                <StackPanel>
                                    <!-- Cabecera de sección -->
                                    <Border BorderThickness="0,0,0,1" Padding="10,5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding MethodDisplay}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                            <Border Grid.Column="1"
                                                    Background="#18888888" CornerRadius="10" Padding="6,1">
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="9" Opacity="0.7"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- Cabecera de columnas -->
                                    <Grid ColumnDefinitions="40,*,58,34,22"
                                          Margin="8,2,14,1">
                                        <TextBlock Grid.Column="0" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Level]}"  FontSize="9" Opacity="0.5" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Move]}"  FontSize="9" Opacity="0.5" Margin="5,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Type]}"  FontSize="9" Opacity="0.5" Margin="2,0,0,0"/>
                                        <TextBlock Grid.Column="3" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Power]}"  FontSize="9" Opacity="0.5" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <!-- Filas de movimientos -->
                                    <ItemsControl ItemsSource="{Binding Moves}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:LearnsetEntry">
                                                <Border BorderThickness="0,0,0,1" Padding="8,2,6,2">
                                                    <Grid ColumnDefinitions="40,*,58,34,22" Margin="0,0,8,0">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding LevelOrItemDisplay}"
                                                                   FontSize="10" Opacity="0.5"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding MoveName}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Margin="5,0,4,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Background="Transparent"
                                                                   ToolTip.Tip="{Binding Tooltip}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2"
                                                                Background="{Binding TypeName, Converter={StaticResource TypeColorConverter}}"
                                                                CornerRadius="3" Padding="3,1"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeName, Converter={StaticResource TypeNameConverter}}"
                                                                       FontSize="8" FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding PowerDisplay}"
                                                                   FontSize="10" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                        <Ellipse Grid.Column="4"
                                                                 Width="7" Height="7"
                                                                 Fill="{Binding DamageClass, Converter={StaticResource DamageClassDotConverter}}"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ══════════════════════════════════════════════════════════
             Tab — Type Effectiveness (movido desde PokemonInfoView, antes
             vivía pegado abajo del panel de Identity/Status/Origin — ver
             sesión de rediseño). Vertical (Receives arriba, Hits abajo) en
             vez de las 3 columnas de antes, porque un tab crece en vertical
             y las 3 columnas no entraban con el ancho disponible acá.
        ══════════════════════════════════════════════════════════════ -->
        <TabItem Header="{Binding Loc[Tab_Effectiveness]}">
            <DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <!-- ── RECEIVES ── -->
                        <TextBlock Text="{Binding Loc[Eff_Receives]}" FontSize="10" FontWeight="SemiBold"
                                   Opacity="0.7" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding TypeWeaknesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TypeEffectivenessEntry">
                                    <Border Padding="0,3" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="36,*">
                                            <Border Grid.Column="0"
                                                    Background="#CC222222" CornerRadius="4"
                                                    Padding="4,2" HorizontalAlignment="Center"
                                                    VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding Multiplier}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ItemsControl Grid.Column="1"
                                                          ItemsSource="{Binding DefenseTypeList}"
                                                          Margin="6,0,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding ., Converter={StaticResource TypeColorConverter}}"
                                                                CornerRadius="3" Padding="4,1" Margin="1,1">
                                                            <TextBlock Text="{Binding Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Grid.Column="1" Text="—" FontSize="9" Opacity="0.4"
                                                       Margin="6,2,0,0" IsVisible="{Binding !HasDefense}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderThickness="0,1,0,0" Opacity="0.15" Margin="0,10,0,10"/>

                        <!-- ── HITS ── -->
                        <TextBlock Text="{Binding Loc[Eff_Hits]}" FontSize="10" FontWeight="SemiBold"
                                   Opacity="0.7" Margin="0,0,0,4"/>

                        <!-- Badges de los tipos propios, una sola vez arriba de HITS (antes
                             estaba arriba de toda la tabla) — solo tiene sentido acá, Receives
                             nunca se separa por tipo propio. -->
                        <Grid ColumnDefinitions="36,*" IsVisible="{Binding HasType2}" Margin="0,0,0,6">
                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                <Border Grid.Column="0"
                                        BorderBrush="{Binding Type1, Converter={StaticResource TypeColorConverter}}"
                                        BorderThickness="1.3" CornerRadius="10" Padding="5,1"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Type1, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{Binding Type1, Converter={StaticResource TypeColorConverter}}"/>
                                </Border>
                                <Border Grid.Column="1"
                                        BorderBrush="{Binding Type2, Converter={StaticResource TypeColorConverter}}"
                                        BorderThickness="1.3" CornerRadius="10" Padding="5,1"
                                        Margin="8,0,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Type2, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{Binding Type2, Converter={StaticResource TypeColorConverter}}"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TypeWeaknesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TypeEffectivenessEntry">
                                    <Border Padding="0,3" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="36,*">
                                            <Border Grid.Column="0"
                                                    Background="#CC222222" CornerRadius="4"
                                                    Padding="4,2" HorizontalAlignment="Center"
                                                    VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding Multiplier}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- Un solo tipo propio: lista plana (ver ShowFlatOffense —
                                                 nunca hubo badge de tipo propio acá, TypeEffectivenessDatabase
                                                 nunca generó prefijo para tipo único). -->
                                            <ItemsControl Grid.Column="1"
                                                          ItemsSource="{Binding OffenseTargets1}"
                                                          IsVisible="{Binding ShowFlatOffense}"
                                                          Margin="6,0,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding ., Converter={StaticResource TypeColorConverter}}"
                                                                CornerRadius="3" Padding="4,1" Margin="1,1">
                                                            <TextBlock Text="{Binding Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Grid.Column="1" Text="—" FontSize="9" Opacity="0.4"
                                                       Margin="6,2,0,0" IsVisible="{Binding ShowFlatOffenseEmpty}"/>

                                            <!-- Doble tipo propio: 2 subcolumnas fijas (una por tipo, ver
                                                 header con los badges Type1/Type2 arriba, no repetidos acá
                                                 fila por fila). "—" cuando ese tipo propio no pega nada en
                                                 esta fila, para que las filas sigan alineadas entre sí. -->
                                            <Grid Grid.Column="1" ColumnDefinitions="*,*"
                                                  IsVisible="{Binding ShowSplitOffense}"
                                                  Margin="6,0,0,0">
                                                <ItemsControl Grid.Column="0" ItemsSource="{Binding OffenseTargets1}"
                                                              IsVisible="{Binding HasOffense1}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding ., Converter={StaticResource TypeColorConverter}}"
                                                                    CornerRadius="3" Padding="4,1" Margin="1,1">
                                                                <TextBlock Text="{Binding Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Column="0" Text="—" FontSize="9" Opacity="0.4"
                                                           IsVisible="{Binding !HasOffense1}"/>

                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding OffenseTargets2}"
                                                              IsVisible="{Binding HasOffense2}" Margin="8,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding ., Converter={StaticResource TypeColorConverter}}"
                                                                    CornerRadius="3" Padding="4,1" Margin="1,1">
                                                                <TextBlock Text="{Binding Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Column="1" Text="—" FontSize="9" Opacity="0.4"
                                                           Margin="8,0,0,0" IsVisible="{Binding !HasOffense2}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ══════════════════════════════════════════════════════════
             Tab 4 — Recommended Sets
        ══════════════════════════════════════════════════════════════ -->
        <TabItem Header="{Binding Loc[Tab_Sets]}" IsVisible="{Binding TabSets}">
            <DockPanel>

                <!-- Legend (same pattern as Learnsets tab) -->
                <Border DockPanel.Dock="Top"
                        BorderThickness="0,0,0,1" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="7" Height="7" Fill="#C14A1A" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Move_Class_Physical]}" FontSize="10" Foreground="#C14A1A" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="7" Height="7" Fill="#2860B0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Move_Class_Special]}"  FontSize="10" Foreground="#2860B0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="7" Height="7" Fill="#4A8220" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Move_Class_Status]}"   FontSize="10" Foreground="#4A8220" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sets grouped by Source · Generation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecommendedSetGroups}" Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RecommendedSetGroup">
                                <StackPanel>

                                    <!-- Section header: "Smogon  ·  Gen 9  [count]" -->
                                    <Border BorderThickness="0,0,0,1" Padding="10,5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Header}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                            <Border Grid.Column="1"
                                                    Background="#18888888" CornerRadius="10" Padding="6,1">
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="9" Opacity="0.7"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Sets in this group -->
                                    <ItemsControl ItemsSource="{Binding Sets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="services:RecommendedSet">
                                                <Border BorderThickness="0,0,0,1" Padding="8,6,6,6">
                                                    <StackPanel Spacing="3">

                                                        <!-- Set name + source badge -->
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SetName}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="1"
                                                                    CornerRadius="10" Padding="6,1"
                                                                    Margin="4,0,0,0"
                                                                    Background="#22888888"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SourceDisplay}"
                                                                           FontSize="9" Opacity="0.7"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Ability / Item / Nature / Level row -->
                                                        <WrapPanel Margin="0,1,0,0">
                                                            <TextBlock IsVisible="{Binding HasAbility}"
                                                                       
                                                                       FontSize="10" Opacity="0.75"
                                                                       Margin="0,0,10,2"><Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Sets_Ability]}"/><Run Text="{Binding AbilityDisplay}"/></TextBlock>
                                                            <StackPanel IsVisible="{Binding HasItem}"
                                                                        Orientation="Horizontal" Spacing="3"
                                                                        Margin="0,0,10,2"
                                                                        ToolTip.Tip="{Binding ItemDescription}">
                                                                <Image Source="{Binding Item, Converter={StaticResource ItemSpriteConverter}}"
                                                                       Width="14" Height="14"
                                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                                                <TextBlock 
                                                                           FontSize="10" Opacity="0.75"
                                                                           TextWrapping="Wrap"><Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Sets_Item]}"/><Run Text="{Binding ItemDisplay}"/></TextBlock>
                                                            </StackPanel>
                                                            <TextBlock IsVisible="{Binding HasNature}"
                                                                       
                                                                       FontSize="10" Opacity="0.75"
                                                                       Margin="0,0,10,2"><Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Sets_Nature]}"/><Run Text="{Binding Nature, Converter={StaticResource NatureNameConverter}}"/></TextBlock>
                                                            <TextBlock IsVisible="{Binding HasLevel}"
                                                                       
                                                                       FontSize="10" Opacity="0.75"
                                                                       Margin="0,0,10,2"><Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Sets_Level]}"/><Run Text="{Binding Level}"/></TextBlock>
                                                        </WrapPanel>

                                                        <!-- EVs / IVs / Tera -->
                                                        <TextBlock IsVisible="{Binding HasCustomEvs}"
                                                                   
                                                                   FontSize="10" Opacity="0.7"
                                                                   TextWrapping="Wrap"><Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Sets_Evs]}"/><Run Text="{Binding EvsFormatted}"/></TextBlock>
                                                        <TextBlock IsVisible="{Binding HasCustomIvs}"
                                                                   
                                                                   FontSize="10" Opacity="0.6"
                                                                   TextWrapping="Wrap"><Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Sets_Ivs]}"/><Run Text="{Binding IvsFormatted}"/></TextBlock>
                                                        <TextBlock IsVisible="{Binding HasTeraType}"
                                                                   
                                                                   FontSize="10" Opacity="0.7"><Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Sets_TeraType]}"/><Run Text="{Binding TeraTypesDisplay, Converter={StaticResource TypeNameConverter}}"/></TextBlock>

                                                        <!-- Column headers -->
                                                        <Grid ColumnDefinitions="*,58,34,22"
                                                              Margin="0,3,14,1">
                                                            <TextBlock Grid.Column="0" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Move]}"
                                                                       FontSize="9" Opacity="0.5"/>
                                                            <TextBlock Grid.Column="1" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Type]}"
                                                                       FontSize="9" Opacity="0.5"/>
                                                            <TextBlock Grid.Column="2" Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Move_Col_Power]}"
                                                                       FontSize="9" Opacity="0.5"
                                                                       HorizontalAlignment="Right"/>
                                                        </Grid>

                                                        <!-- Move rows — same pattern as Learnsets -->
                                                        <ItemsControl ItemsSource="{Binding ResolvedMoves}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="services:SetMoveEntry">
                                                                    <Border BorderThickness="0,1,0,0" Padding="0,2">
                                                                        <Grid ColumnDefinitions="*,58,34,22" Margin="0,0,14,0">
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding MoveName}"
                                                                                       FontSize="10" FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center"
                                                                                       ToolTip.Tip="{Binding Description}"/>
                                                                            <Border Grid.Column="1"
                                                                                    Background="{Binding TypeName, Converter={StaticResource TypeColorConverter}}"
                                                                                    CornerRadius="3" Padding="3,1"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding TypeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                                <TextBlock Text="{Binding TypeName, Converter={StaticResource TypeNameConverter}}"
                                                                                           FontSize="8" FontWeight="Bold"
                                                                                           Foreground="White"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding PowerDisplay}"
                                                                                       FontSize="10"
                                                                                       HorizontalAlignment="Right"
                                                                                       VerticalAlignment="Center"/>
                                                                            <Ellipse Grid.Column="3"
                                                                                     Width="7" Height="7"
                                                                                     Fill="{Binding DamageClass, Converter={StaticResource DamageClassDotConverter}}"
                                                                                     VerticalAlignment="Center"
                                                                                     HorizontalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ══════════════════════════════════════════════════════════
             Tabs condicionales
        ══════════════════════════════════════════════════════════════ -->
        <TabItem Header="{Binding Loc[Tab_Special]}"  IsVisible="{Binding TabSpecial}">
            <ScrollViewer>
                <StackPanel Margin="12" Spacing="10">

                    <!-- Convención de las tarjetas con tipo (Mega, Z-Moves, Tera): franja izquierda con el color
                         del tipo + fondo/borde suaves del mismo tipo + pill con letra legible (oscura sobre
                         tipos claros, TypeTextColorConverter). Dynamax y Alpha no tienen tipo: color fijo. -->

                    <!-- Mega Evolution (Gen 6 XY/ORAS, Gen 7 SM/USUM) -->
                    <!-- Sin campo propio en el PKM: depende 100% del held item (Mega Stone). -->
                    <Border IsVisible="{Binding TabMega}" CornerRadius="10" ClipToBounds="True"
                            Classes.special-active="{Binding MegaCompatible}"
                            Background="{Binding MegaType1, Converter={StaticResource TypeToSoftBrush}}"
                            BorderThickness="1">
                        <Border.BorderBrush>
                            <MultiBinding Converter="{StaticResource TypeToActiveBorder}">
                                <Binding Path="MegaType1"/>
                                <Binding Path="MegaCompatible"/>
                            </MultiBinding>
                        </Border.BorderBrush>
                        <Grid ColumnDefinitions="8,*">
                            <Border Grid.Column="0" Background="{Binding MegaType1, Converter={StaticResource TypeColorConverter}}"/>
                            <StackPanel Grid.Column="1" Margin="10,8" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Special_Mega]}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" IsVisible="{Binding MegaCompatible}" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"
                                            Background="{Binding MegaType1, Converter={StaticResource TypeColorConverter}}">
                                        <TextBlock Text="{Binding MegaType1, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding MegaType1, Converter={StaticResource TypeTextColorConverter}}"/>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="3" Padding="5,1"
                                            IsVisible="{Binding MegaType2, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Background="{Binding MegaType2, Converter={StaticResource TypeColorConverter}}">
                                        <TextBlock Text="{Binding MegaType2, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding MegaType2, Converter={StaticResource TypeTextColorConverter}}"/>
                                    </Border>
                                </Grid>

                                <!-- Selector rápido: solo las piedras compatibles con esta especie, no las ~900 del combo general -->
                                <ComboBox IsVisible="{Binding HasMegaStoneOptions}"
                                          ItemsSource="{Binding MegaStoneOptions}" SelectionChanged="OnMegaOptionPicked"
                                          PlaceholderText="{Binding Loc[Special_EquipMega]}" FontSize="10" Height="22" MinHeight="0"
                                          Padding="4,0" HorizontalAlignment="Stretch"/>

                                <!-- Objeto equipado (esta tarjeta es el único lugar donde se ve y se quita) -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasEquippedMegaItem}">
                                    <TextBlock Grid.Column="0" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Loc[Special_Equipped]}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/><Run Text="{Binding EquippedMegaItemName}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="{Binding Loc[Action_Remove]}" FontSize="9" Height="18" MinHeight="0" Padding="8,0"
                                            Click="OnUnequipHeldItem" ToolTip.Tip="{Binding Loc[Special_Unequip_Tip]}"/>
                                </Grid>
                                <TextBlock Text="{Binding MegaSwapNote}" FontSize="9" Opacity="0.65" TextWrapping="Wrap"
                                           IsVisible="{Binding MegaSwapNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding MegaOtherItemNote}" FontSize="9" Opacity="0.65" TextWrapping="Wrap"
                                           IsVisible="{Binding MegaOtherItemNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <StackPanel IsVisible="{Binding MegaCompatible}" Spacing="2">
                                    <TextBlock FontSize="10">
                                        <Run Text="✓ "/><Run Text="{Binding MegaFormName}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding MegaSummary}" FontSize="9" Opacity="0.65"/>
                                </StackPanel>

                                <TextBlock IsVisible="{Binding !MegaCompatible}"
                                           Text="{Binding MegaStatusText}"
                                           FontSize="10" Opacity="0.65" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Z-Moves (Gen 7 SM/USUM) -->
                    <!-- Sin campo propio en el PKM: depende del held item (Z-Crystal) + match de movimiento. -->
                    <Border IsVisible="{Binding TabZMoves}" CornerRadius="10" ClipToBounds="True"
                            Classes.special-active="{Binding ZMoveCompatible}"
                            Background="{Binding ZMoveType, Converter={StaticResource TypeToSoftBrush}}"
                            BorderThickness="1">
                        <Border.BorderBrush>
                            <MultiBinding Converter="{StaticResource TypeToActiveBorder}">
                                <Binding Path="ZMoveType"/>
                                <Binding Path="ZMoveCompatible"/>
                            </MultiBinding>
                        </Border.BorderBrush>
                        <Grid ColumnDefinitions="8,*">
                            <Border Grid.Column="0" Background="{Binding ZMoveType, Converter={StaticResource TypeColorConverter}}"/>
                            <StackPanel Grid.Column="1" Margin="10,8" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Special_ZMoves]}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="5,1"
                                            IsVisible="{Binding ZMoveType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Background="{Binding ZMoveType, Converter={StaticResource TypeColorConverter}}">
                                        <TextBlock Text="{Binding ZMoveType, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding ZMoveType, Converter={StaticResource TypeTextColorConverter}}"/>
                                    </Border>
                                </Grid>

                                <!-- Selector rápido: solo los cristales relevantes para los movimientos/especie actuales -->
                                <ComboBox IsVisible="{Binding HasZCrystalOptions}"
                                          ItemsSource="{Binding ZCrystalOptions}" SelectionChanged="OnZCrystalOptionPicked"
                                          PlaceholderText="{Binding Loc[Special_EquipZ]}" FontSize="10" Height="22" MinHeight="0"
                                          Padding="4,0" HorizontalAlignment="Stretch"/>

                                <!-- Objeto equipado (esta tarjeta es el único lugar donde se ve y se quita) -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasEquippedZItem}">
                                    <TextBlock Grid.Column="0" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Loc[Special_Equipped]}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/><Run Text="{Binding EquippedZItemName}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="{Binding Loc[Action_Remove]}" FontSize="9" Height="18" MinHeight="0" Padding="8,0"
                                            Click="OnUnequipHeldItem" ToolTip.Tip="{Binding Loc[Special_Unequip_Tip]}"/>
                                </Grid>
                                <TextBlock Text="{Binding ZSwapNote}" FontSize="9" Opacity="0.65" TextWrapping="Wrap"
                                           IsVisible="{Binding ZSwapNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding ZOtherItemNote}" FontSize="9" Opacity="0.65" TextWrapping="Wrap"
                                           IsVisible="{Binding ZOtherItemNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <StackPanel IsVisible="{Binding ZMoveCompatible}" Spacing="2">
                                    <TextBlock FontSize="10">
                                        <Run Text="✓ "/><Run Text="{Binding ZMoveResultName}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Opacity="0.65">
                                        <Run Text="{Binding Loc[Special_Via]}"/><Run Text="{Binding ZMoveSourceMove}"/>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock IsVisible="{Binding !ZMoveCompatible}"
                                           Text="{Binding ZMoveStatusText}"
                                           FontSize="10" Opacity="0.65" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ZMoveNote}" FontSize="9" Opacity="0.55" TextWrapping="Wrap"
                                           IsVisible="{Binding ZMoveNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dynamax / Gigantamax (Gen 8: Sword/Shield) -->
                    <!-- Campos reales y persistentes por Pokémon: PK8.DynamaxLevel (0-10) y PK8.CanGigantamax. -->
                    <Border IsVisible="{Binding TabDynamax}" CornerRadius="10" Padding="10,8"
                            Classes.special-active="{Binding DynamaxActive}"
                            Classes.dynamax-active="{Binding DynamaxActive}"
                            Background="#FCEDEE" BorderBrush="#E8A0A8" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Special_Dynamax]}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" IsVisible="{Binding CanGigantamax}"
                                        Background="#C9A227" CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="{Binding Loc[Special_GmaxBadge]}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- Dynamax Level: barra de 10 segmentos + stepper -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Special_DynamaxLevel]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                <ItemsControl Grid.Column="1" Margin="10,0" VerticalAlignment="Center" ItemsSource="{Binding DynamaxSegments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PpSegment">
                                            <Border Height="8" CornerRadius="2" Margin="1,0" Background="{Binding Brush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="2" Content="−" FontSize="10" Width="20" Height="20" Padding="0"
                                        Tag="DynamaxLevel:0:10" Click="OnSpinnerDecrement"/>
                                <TextBlock Grid.Column="3" Text="{Binding DynamaxLevel, StringFormat='{}{0}/10'}"
                                           FontSize="10" FontWeight="SemiBold" Width="34"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="4" Content="+" FontSize="10" Width="20" Height="20" Padding="0"
                                        Tag="DynamaxLevel:0:10" Click="OnSpinnerIncrement"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="0" FontSize="9" MinWidth="26" Height="18" Padding="6,0" Tag="DynamaxLevel:0:10" Click="OnSpinnerMin"/>
                                <Button Content="10" FontSize="9" MinWidth="26" Height="18" Padding="6,0" Tag="DynamaxLevel:0:10" Click="OnSpinnerMax"/>
                                <TextBlock Text="{Binding DynamaxHpBonusText}" FontSize="10" Opacity="0.65" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Gigantamax: solo editable si la especie lo admite -->
                            <Grid ColumnDefinitions="Auto,*" Height="24">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Special_CanGmax]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding CanGigantamax}" IsEnabled="{Binding GigantamaxEditable}"
                                          FontSize="10" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding GigantamaxNote}" FontSize="9" Opacity="0.65" TextWrapping="Wrap"
                                       IsVisible="{Binding GigantamaxNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Alpha / Noble (Gen 8: Legends Arceus; Z-A solo Alpha) -->
                    <!-- Campos reales: PA8.IsAlpha / PA8.IsNoble, PA9.IsAlpha. -->
                    <Border IsVisible="{Binding TabAlpha}" CornerRadius="10" Padding="10,8"
                            Classes.special-active="{Binding AlphaActive}"
                            Classes.alpha-active="{Binding AlphaActive}"
                            Background="#F6E9EC" BorderBrush="#B85C6E" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding AlphaCardTitle}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" IsVisible="{Binding IsAlpha}"
                                        Background="#8B1E3F" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding Loc[Special_AlphaBadge]}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border Grid.Column="2" IsVisible="{Binding IsNoble}"
                                        Background="#5A1030" CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="{Binding Loc[Special_NobleBadge]}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" Height="24">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Special_IsAlpha]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsAlpha}"
                                          FontSize="10" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" Height="24" IsVisible="{Binding HasNoble}">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[Special_IsNoble]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsNoble}"
                                          FontSize="10" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding Loc[Special_AlphaWarn]}"
                                       FontSize="9" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Terastallize (Gen 9: Scarlet/Violet) -->
                    <!-- Campos reales: PK9.TeraTypeOriginal (solo lectura) / TeraTypeOverride (editable). -->
                    <Border IsVisible="{Binding TabTerastal}" CornerRadius="10" ClipToBounds="True"
                            Background="{Binding TeraType, Converter={StaticResource TypeToSoftBrush}}"
                            BorderBrush="{Binding TeraType, Converter={StaticResource TypeToSoftBorder}}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="8,*">
                            <Border Grid.Column="0" Background="{Binding TeraType, Converter={StaticResource TypeColorConverter}}"/>
                            <StackPanel Grid.Column="1" Margin="10,8" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Special_TeraType]}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="5,1"
                                            IsVisible="{Binding TeraType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Background="{Binding TeraType, Converter={StaticResource TypeColorConverter}}">
                                        <TextBlock Text="{Binding TeraType, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding TeraType, Converter={StaticResource TypeTextColorConverter}}"/>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,Auto,*" Height="22">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Special_Original]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Width="60"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                            IsVisible="{Binding TeraOriginalType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Background="{Binding TeraOriginalType, Converter={StaticResource TypeColorConverter}}">
                                        <TextBlock Text="{Binding TeraOriginalType, Converter={StaticResource TypeNameConverter}}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding TeraOriginalType, Converter={StaticResource TypeTextColorConverter}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Loc[Special_TeraLocked]}" FontSize="9" Opacity="0.65"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" Height="24">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Special_Override]}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Width="60"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TeraOverrideOptions}"
                                              SelectedIndex="{Binding SelectedTeraOverrideIndex}"
                                              IsEnabled="{Binding TeraOverrideEditable}"
                                              FontSize="10" Height="22" MinHeight="0" Padding="4,0" HorizontalAlignment="Stretch"/>
                                </Grid>

                                <TextBlock Text="{Binding TeraOverrideNote}" FontSize="9" Opacity="0.65" TextWrapping="Wrap"
                                           IsVisible="{Binding TeraOverrideNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Etapa 4.6.6 — tab Diagnóstico: checklist completo de DiagnosticSteps (Invalid +
             Fishy, a diferencia de las fichas de la cabecera que solo muestran Invalid). v1
             puramente informativo — sin botón "Aplicar" todavía (ver DiagnosticStep.cs,
             sección "v2" de sus doc-comments: eso requeriría reusar EditApplyService para
             escribir FieldFix.SuggestedValueRaw, deliberadamente fuera de esta etapa). -->
        <TabItem>
            <!-- La pestaña muestra la alerta roja siempre que exista cualquier ilegalidad (igual que IVs/EVs,
                 Moves y Cintas): es adonde se va a ver el detalle o aplicar una corrección. -->
            <TabItem.Header>
                <!-- Pestaña "Legal": barra inferior verde (todo en orden) o roja (hay alertas) para leerla de un vistazo. -->
                <Grid MinWidth="44">
                    <TextBlock Text="{Binding Loc[Tab_Legal]}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0,2,5"/>
                    <Border Height="4" VerticalAlignment="Bottom" CornerRadius="2" Background="#2E7D32"
                            BoxShadow="0 2 6 0 #802E7D32" IsVisible="{Binding DiagnosticTabOk}"/>
                    <Border Height="4" VerticalAlignment="Bottom" CornerRadius="2" Background="#E30909"
                            BoxShadow="0 2 6 0 #80E30909" IsVisible="{Binding HasDiagnosticIssue}"/>
                </Grid>
            </TabItem.Header>
            <ScrollViewer>
                <StackPanel Margin="12" Spacing="10">

                    <!-- Estado sin problemas — el Pokémon puede no tener NINGÚN
                         DiagnosticStep (ni Invalid ni Fishy) y aun así no ser un caso raro,
                         simplemente está limpio. -->
                    <Border IsVisible="{Binding !DiagnosticSteps.Count}"
                            Background="#EAF6F0" BorderBrush="#2E7D32" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <TextBlock Text="{Binding Loc[Legal_AllClear]}"
                                   FontSize="11" TextWrapping="Wrap" Foreground="#2E7D32"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding DiagnosticSteps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="app:DiagnosticStep">
                                <Border CornerRadius="8" BorderThickness="1" Padding="10,8"
                                        Background="{Binding Severity, Converter={StaticResource SeverityBackgroundConverter}}"
                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityBorderConverter}}">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding CategoryLabel}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityTextConverter}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Severity, Converter={StaticResource SeverityLabelConverter}}"
                                                       FontSize="9" Opacity="0.75"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityTextConverter}}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap"/>

                                        <!-- Fixes accionables — puede estar vacío (Nivel C: sin
                                             valor conocible, ver DiagnosticStep.Fixes), en cuyo
                                             caso este ItemsControl simplemente no renderiza nada. -->
                                        <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,2,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="app:FieldFix">
                                                    <StackPanel Spacing="2">
                                                        <!-- Filas con texto propio (Recrear con un encuentro válido, nivel de Gen1,
                                                             aviso "sin corrección"): reemplazan el renglón "tenías / sugerido". -->
                                                        <TextBlock IsVisible="{Binding HasNote}" Text="{Binding Note}"
                                                                   FontSize="10" TextWrapping="Wrap" Opacity="0.9"/>
                                                        <TextBlock IsVisible="{Binding ShowSuggestion}" FontSize="10" TextWrapping="Wrap" Opacity="0.85">
                                                            <Run Text="{Binding FieldLabel}" FontWeight="SemiBold"/>
                                                            <Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Legal_Had]}"/>
                                                            <Run Text="{Binding CurrentValueDisplay}"/>
                                                            <Run Text="{ReflectionBinding $parent[UserControl].DataContext.Loc[Legal_Suggested]}"/>
                                                            <Run Text="{Binding SuggestedValueDisplay}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                        <!-- Post-4.6 — botón "Corregir automáticamente" (FieldFixAction != None).
                                                             Ausente para la enorme mayoría de los FieldFix (Nickname, MetLocation,
                                                             IVs/EVs, etc.) — esos se siguen arreglando a mano tocando el campo
                                                             resaltado. Solo aparece para los pocos casos (PID por ahora) donde no
                                                             hay un control de UI propio y arreglarlo es una acción calculada, no
                                                             "pegar un número". Click en code-behind (no Command) porque el
                                                             DataContext acá es el FieldFix, no el PokemonEditorViewModel — mismo
                                                             patrón que OnOpenMoveSelector un poco más arriba en este archivo. -->
                                                        <Button Classes="autofix" HorizontalAlignment="Left"
                                                                IsVisible="{Binding HasAutoFix}"
                                                                Click="OnApplyAutoFix">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Path Classes="autofix-icon" Stretch="Uniform" Width="11" Height="11"
                                                                      VerticalAlignment="Center"
                                                                      Data="M22.7,19 L13.6,9.9 C14.5,7.6 14,4.9 12.1,3 C10.1,1 7.1,0.6 4.7,1.7 L9,6 L6,9 L1.7,4.7 C0.6,7.1 1.1,10.1 3.1,12.1 C5,14 7.7,14.5 10,13.6 L19.1,22.7 C19.5,23.1 20.1,23.1 20.5,22.7 L22.8,20.4 C23.2,20 23.2,19.4 22.7,19 Z"/>
                                                                <TextBlock Text="{Binding ButtonText}" FontSize="10" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Expander Header="{ReflectionBinding $parent[UserControl].DataContext.Loc[Legal_TechDetail]}" FontSize="9" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding TechnicalDetail}" FontSize="9"
                                                       Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem IsVisible="{Binding TabRibbons}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Loc[Tab_Ribbons]}" VerticalAlignment="Center"/>
                    <Border Width="12" Height="12" CornerRadius="2" Background="#E30909" BorderBrush="#7A0000" BorderThickness="1.2"
                            VerticalAlignment="Center" IsVisible="{Binding HasRibbonsIssue}">
                        <TextBlock Text="!" FontSize="8" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="8"/>
                    </Border>
                </StackPanel>
            </TabItem.Header>
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Watermark="{Binding Loc[Ribbons_Search]}" Text="{Binding RibbonSearchText}"
                                 FontSize="11" Height="24" Padding="6,2"/>
                        <TextBlock Grid.Column="1" Text="{Binding RibbonSummary}" FontSize="10" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    <!-- Barra de total (N de M obtenidas) -->
                    <Grid Height="4">
                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding RibbonProgressFill, Converter={StaticResource StarWidthConverter}}"/>
                                <ColumnDefinition Width="{Binding RibbonProgressRest, Converter={StaticResource StarWidthConverter}}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#2C2C2A" CornerRadius="2"/>
                        </Grid>
                    </Grid>
                    <ItemsControl x:Name="RibbonChipsControl" ItemsSource="{Binding RibbonCategoryChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RibbonChipViewModel">
                                <Button Content="{Binding DisplayName}"
                                        Tag="{Binding Category}" Click="OnRibbonCategoryChipClick"
                                        FontSize="10" Padding="8,3" Margin="0,0,6,6" CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="{Binding Category, Converter={StaticResource RibbonCategoryBorder}}">
                                    <Button.Background>
                                        <MultiBinding Converter="{StaticResource RibbonChipBackground}">
                                            <Binding Path="Category"/>
                                            <Binding Path="IsSelected"/>
                                        </MultiBinding>
                                    </Button.Background>
                                    <Button.Foreground>
                                        <MultiBinding Converter="{StaticResource RibbonChipForeground}">
                                            <Binding Path="Category"/>
                                            <Binding Path="IsSelected"/>
                                        </MultiBinding>
                                    </Button.Foreground>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding RibbonGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RibbonGroupViewModel">
                                <Border Classes="ribbon-card" Classes.expanded="{Binding IsExpanded}"
                                        Classes.collapsed="{Binding IsCollapsed}"
                                        CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                    <StackPanel>
                                        <!-- Encabezado: ícono · nombre · conteo · chevron (plegar solo en "Todas" sin búsqueda) -->
                                        <Button Classes="ribbon-head" Click="OnRibbonGroupHeaderClick"
                                                IsHitTestVisible="{Binding IsToggleable}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="7" Margin="0,0,8,0"
                                                        Background="{Binding Category, Converter={StaticResource RibbonCategoryBackground}}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{Binding IconGeometry}" StrokeThickness="1.8"
                                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                                  Stroke="{Binding Category, Converter={StaticResource RibbonCategoryText}}"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock Grid.Column="1" Classes="ribbon-header" VerticalAlignment="Center"
                                                           Text="{Binding CategoryDisplay}"
                                                           Foreground="{Binding Category, Converter={StaticResource RibbonCategoryText}}"/>
                                                <Border Grid.Column="2" Background="#18888888" CornerRadius="10" Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Classes="ribbon-count" Text="{Binding CountLabel}"
                                                               Foreground="{Binding Category, Converter={StaticResource RibbonCategoryText}}"/>
                                                </Border>
                                                <Viewbox Grid.Column="3" Width="14" Height="14" Margin="8,0,0,0"
                                                         IsVisible="{Binding IsToggleable}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Classes="ribbon-chevron" Data="{StaticResource IconChevron}"
                                                              Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                        </Button>

                                        <!-- Barra de progreso de la categoría -->
                                        <Grid Height="4" Margin="0,7,0,0" IsVisible="{Binding IsBodyVisible}">
                                            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Opacity="0.3" CornerRadius="2"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding ProgressFill, Converter={StaticResource StarWidthConverter}}"/>
                                                    <ColumnDefinition Width="{Binding ProgressRest, Converter={StaticResource StarWidthConverter}}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="2"
                                                        Background="{Binding Category, Converter={StaticResource RibbonCategoryBorder}}"/>
                                            </Grid>
                                        </Grid>

                                        <ItemsControl Classes="ribbon-items" ItemsSource="{Binding Items}"
                                                      IsVisible="{Binding IsBodyVisible}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:RibbonItemViewModel">
                                                    <!-- Tarjeta-medalla: obtenida = color de la categoría + ✓; pendiente = gris punteado -->
                                                    <ToggleButton Classes="ribbon-tile" IsChecked="{Binding IsObtained}"
                                                                  ToolTip.Tip="{Binding DisplayName}">
                                                        <Grid>
                                                            <Border CornerRadius="9" BorderThickness="1">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource RibbonTileBrush}" ConverterParameter="bg">
                                                                        <Binding Path="Category"/>
                                                                        <Binding Path="IsObtained"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                                <Border.BorderBrush>
                                                                    <MultiBinding Converter="{StaticResource RibbonTileBrush}" ConverterParameter="border">
                                                                        <Binding Path="Category"/>
                                                                        <Binding Path="IsObtained"/>
                                                                    </MultiBinding>
                                                                </Border.BorderBrush>
                                                            </Border>
                                                            <Rectangle RadiusX="9" RadiusY="9" Stroke="#CFCDC4" StrokeThickness="1"
                                                                       StrokeDashArray="3,2" IsVisible="{Binding !IsObtained}"/>
                                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="7,5">
                                                                <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,6,0">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path Data="{StaticResource IconMedal}" StrokeThickness="1.8"
                                                                              StrokeLineCap="Round" StrokeJoin="Round">
                                                                            <Path.Stroke>
                                                                                <MultiBinding Converter="{StaticResource RibbonTileBrush}" ConverterParameter="icon">
                                                                                    <Binding Path="Category"/>
                                                                                    <Binding Path="IsObtained"/>
                                                                                </MultiBinding>
                                                                            </Path.Stroke>
                                                                        </Path>
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <TextBlock Grid.Column="1" Classes="ribbon-tile-text" Text="{Binding ShortName}"
                                                                           TextWrapping="Wrap" VerticalAlignment="Center">
                                                                    <TextBlock.Foreground>
                                                                        <MultiBinding Converter="{StaticResource RibbonTileBrush}" ConverterParameter="fg">
                                                                            <Binding Path="Category"/>
                                                                            <Binding Path="IsObtained"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Foreground>
                                                                </TextBlock>
                                                                <Border Grid.Column="2" Width="16" Height="16" CornerRadius="8" Margin="6,0,0,0"
                                                                        VerticalAlignment="Center" IsVisible="{Binding IsObtained}"
                                                                        Background="{Binding Category, Converter={StaticResource RibbonCategoryText}}">
                                                                    <Viewbox Width="10" Height="10">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.5"
                                                                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

    </TabControl>

</UserControl>
