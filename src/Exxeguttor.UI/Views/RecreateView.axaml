<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exxeguttor.UI.ViewModels"
             x:Class="Exxeguttor.UI.Views.RecreateView"
             x:DataType="vm:RecreateViewModel"
             IsVisible="{Binding IsVisible}">

    <!-- Modal de confirmación "Recrear con un encuentro válido" (mockups/encounter_recreate/). También
         confirma el catch rate inválido y el nivel demasiado bajo de Gen1. Mismas dos capas que los demás
         diálogos: dim de ventana completa + tarjeta blanca centrada. Colores de la paleta de la app. -->
    <UserControl.Styles>
        <Style Selector="Border.rctag">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="#EAF6F0"/>
        </Style>
        <Style Selector="Border.rctag.egg">
            <Setter Property="Background" Value="#FFF4EC"/>
        </Style>
        <Style Selector="Border.rctag TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#2F9E5B"/>
        </Style>
        <Style Selector="Border.rctag.egg TextBlock">
            <Setter Property="Foreground" Value="#C2410C"/>
        </Style>
        <Style Selector="TextBlock.rcafter.changed">
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Background="#33000000"/>

        <Border Background="White" BorderBrush="#DCDCE0" BorderThickness="1" CornerRadius="14"
                Padding="24,20" BoxShadow="0 10 24 0 #38000000" Width="440" MaxHeight="620"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel LastChildFill="True">

                <!-- Pie fijo: Cancelar / Aplicar -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Padding="16,6"/>
                    <Button Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" Padding="16,6"
                            Background="#1C1C1F" Foreground="White"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,0,8,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#1C1C1F"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#6B6B70" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border IsVisible="{Binding HasNote}" Background="#EEF4FF" BorderBrush="#C7D9F8"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Gen3/4: conservar la Naturaleza obliga a cambiar IVs (la Naturaleza sale del PID) -->
                        <StackPanel IsVisible="{Binding ShowKeepNature}" Spacing="2">
                            <CheckBox IsChecked="{Binding KeepNature, Mode=TwoWay}"
                                      Content="{Binding KeepNatureLabel}" FontSize="12"/>
                            <TextBlock Text="{Binding KeepNatureHint}" FontSize="10" Foreground="#6B6B70"
                                       TextWrapping="Wrap" Margin="24,0,0,0"/>
                        </StackPanel>
                        <Border IsVisible="{Binding IsBusy}" Background="#FFF4CC" BorderBrush="#E0A800" BorderThickness="2"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding BusyText}" FontSize="14" FontWeight="Bold"
                                           Foreground="#7A4B00" TextWrapping="Wrap"/>
                                <ProgressBar IsIndeterminate="True" Height="6" Foreground="#E0A800"/>
                            </StackPanel>
                        </Border>
                        <TextBlock IsVisible="{Binding HasEmptyText}" Text="{Binding EmptyText}" FontSize="12"
                                   Foreground="#C2410C" TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecreateItemViewModel">
                                    <Border BorderBrush="#DCDCE0" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                        <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#1C1C1F" VerticalAlignment="Center"/>
                                                    <Border Classes="rctag" Classes.egg="{Binding TagIsEgg}" IsVisible="{Binding HasTag}">
                                                        <TextBlock Text="{Binding Tag}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#6B6B70"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button IsVisible="{Binding HasMore}" Content="{Binding MoreLabel}"
                                Command="{Binding ToggleMoreCommand}" HorizontalAlignment="Left"
                                Padding="8,3" FontSize="11"/>

                        <TextBlock IsVisible="{Binding ShowPickHint}" Text="{Binding PickHint}" FontSize="11"
                                   Foreground="#C2410C" TextWrapping="Wrap"/>

                        <!-- Qué cambia -->
                        <StackPanel IsVisible="{Binding HasChangeRows}" Spacing="2">
                            <TextBlock Text="{Binding ChangesHeader}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#1C1C1F" Margin="0,4,0,2"/>
                            <ItemsControl ItemsSource="{Binding ChangeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecreateChangeRow">
                                        <Border BorderBrush="#DCDCE0" BorderThickness="0,1,0,0" Padding="0,5">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Attribute}" FontSize="12" Foreground="#1C1C1F"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Before}" FontSize="12" Foreground="#6B6B70"/>
                                                <TextBlock Grid.Column="2" Text="  →  " FontSize="12" Foreground="#9A9AA0"/>
                                                <TextBlock Grid.Column="3" Classes="rcafter" Classes.changed="{Binding Changed}"
                                                           Text="{Binding After}" FontSize="12" Foreground="#1C1C1F"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
